# Baseline typed demo (required)
# Gemini API key used by the demo Engine. Runtime falls back to GEMINI_API_KEY
# when GOOGLE_API_KEY is unset; keep only one real value in your local .env.
GOOGLE_API_KEY=

# Optional voice: OpenAI realtime
# Used server-side to mint ephemeral browser credentials.
OPENAI_API_KEY=
# Optional model override; defaults to gpt-realtime-2.
OPENAI_REALTIME_MODEL=

# Optional provider reservation (not read by the demo)
ANTHROPIC_API_KEY=

# Optional voice: LiveKit cascade
# Deepgram provides speech-to-text transcription.
DEEPGRAM_API_KEY=

# Cartesia provides text-to-speech synthesis.
CARTESIA_API_KEY=

# livekit-server --dev uses these well-known insecure local-only defaults.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Must use the ws:// or wss:// scheme.
LIVEKIT_URL=ws://localhost:7880
# Optional lifetime of minted access tokens; defaults to 15m.
LIVEKIT_TOKEN_TTL=15m
