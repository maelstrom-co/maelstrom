# ── Required to run the demo ────────────────────────────────────────────
# This is the only key you need to see a Vessel move. Everything below is
# optional.

# Server-held OpenAI key for text planning and optional voice. OpenAI Realtime
# uses it for credential minting and fixed greeting TTS; GPT-Live requires the
# authenticated local exchange opt-in below.
OPENAI_API_KEY=
# Opt in to authenticated, loopback-only GPT-Live exchange in Vite development.
DEMO_LOCAL_SERVER_KEY=0
# Separate local HTTP password (24+ characters); never use the provider key here.
DEMO_LOCAL_PASSWORD=
# Optional engine model override; defaults to gpt-6-luna.
ENGINE_MODEL=

# ── Optional: Jev planner ───────────────────────────────────────────────
# Local demo only: let TypeSafe's Jev model plan chart requests, with a small
# OpenAI call for the reply and the LLM planner as fallback. Needs the
# server OPENAI_API_KEY above. The hosted demo ignores these.

# llm (default), jev (the Jev POC) or jev-composed-pairs (experimental: Jev
# composes the layout from pair answers).
MAELSTROM_PLANNER=llm
# TypeSafe API key; stays on the server and is redacted from logs.
TYPESAFE_API_KEY=
# Pinned Jev model, e.g. jev-1.13.0. Required for both Jev planners; jev-latest drifts.
JEV_MODEL=
# 1 logs every raw Jev reply (jev.reply), each turn's request (jev.request) and
# the shipped result (jev.result) to the ws server console.
JEV_LOG_REPLIES=

# ── Optional: evaluation judge (may incur provider charges) ─────────────
# Credentials alone never enable judging. Explicit --grader/--no-grader override this.
MAELSTROM_ENABLE_LLM_JUDGE=false
# Env-only activation defaults to heuristic + legacy; heuristic is non-LLM.
# MAELSTROM_LLM_JUDGE_PROVIDER=openai
# MAELSTROM_LLM_JUDGE_MODEL=gpt-5.4-mini
# surface (native planner/stage/session rubrics) or legacy (distinct scalar).
# MAELSTROM_LLM_JUDGE_RUBRIC=surface

# ── Optional: OpenAI realtime voice ─────────────────────────────────────
# Fresh visits default to GPT-Live. Select OpenAI Realtime in the UI, or
# uncomment the override below for the existing server-key Realtime setup.
# GPT-Live with a server key requires the authenticated opt-in above.
# VITE_VOICE_PROVIDER=realtime

# Optional model override; defaults to gpt-realtime-2.1.
OPENAI_REALTIME_MODEL=

# ── Optional: LiveKit voice track ───────────────────────────────────────
# The self-hosted alternative to OpenAI realtime: a Deepgram/Cartesia
# STT/TTS agent worker speaking over LiveKit. All four keys go together.

# Speech-to-text in the LiveKit voice agent (nova-3 model),
# via @livekit/agents-plugin-deepgram
DEEPGRAM_API_KEY=
# Text-to-speech synthesis, via @livekit/agents-plugin-cartesia
# Get your key at: https://play.cartesia.ai/
CARTESIA_API_KEY=
# livekit-server --dev uses these well-known insecure local-only defaults.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Must use the ws:// or wss:// scheme.
LIVEKIT_URL=ws://localhost:7880
# Optional lifetime of minted access tokens; defaults to 15m.
LIVEKIT_TOKEN_TTL=15m

# Deadline (ms) for Deepgram to finish draining after endInput(). Expiry closes
# that stream so a clean successor can open; this also derives the successor's
# pending-audio budget. Unset or empty defaults to 5000. Must be finite, positive,
# and no greater than 60000; invalid values fail worker startup.
#MAELSTROM_STT_DRAIN_TIMEOUT_MS=5000

# ── Reserved ────────────────────────────────────────────────────────────

# Google Gemini API key, reserved for a future engine adapter.
# GOOGLE_API_KEY=

# Anthropic API Key — reserved for an Anthropic provider, not read by the
# demo yet
# ANTHROPIC_API_KEY=
