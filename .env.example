# Google Gemini API Key (for @tanstack/ai-gemini, used by the demo engine)
# Reads GOOGLE_API_KEY, falling back to GEMINI_API_KEY if unset.
GOOGLE_API_KEY=

# OpenAI API Key (used by @maelstrom-co/realtime-server's createOpenAIMinter
# to mint ephemeral tokens for OpenAI realtime voice, the demo's default provider)
OPENAI_API_KEY=

# Anthropic API Key — reserved for an Anthropic provider, not read by the demo yet
ANTHROPIC_API_KEY=

# Deepgram API Key (used by @livekit/agents-plugin-deepgram)
# Used for: Speech-to-text transcription in the LiveKit voice agent (nova-2 model)
DEEPGRAM_API_KEY=

# Cartesia API Key (used by @livekit/agents-plugin-cartesia)
# Used for: Text-to-speech synthesis in the LiveKit voice agent
# Get your key at: https://play.cartesia.ai/
CARTESIA_API_KEY=

# LiveKit (for the LiveKit adapter voice spike)
# livekit-server --dev uses these well-known insecure defaults (local only)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880
# Lifetime of minted LiveKit access tokens (optional, default 15m)
LIVEKIT_TOKEN_TTL=15m
