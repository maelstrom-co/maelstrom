# ── Required to run the demo ────────────────────────────────────────────
# This is the only key you need to see a Vessel move. Everything below is
# optional.

# OpenAI API key for the demo text-planning engine, realtime voice mint, and
# the fixed local greeting TTS route (gpt-4o-mini-tts / cedar / WAV only).
OPENAI_API_KEY=
# Optional engine model override; defaults to gpt-5.6-luna.
ENGINE_MODEL=

# ── Optional: Jev planner ───────────────────────────────────────────────
# Local demo only: let TypeSafe's Jev model plan chart requests, with a small
# OpenAI call for the reply and the LLM planner as fallback. Needs the
# server OPENAI_API_KEY above. The hosted demo ignores these.

# llm (default), jev (the Jev POC) or jev-composed-pairs (experimental: Jev
# composes the layout from pair answers).
MAELSTROM_PLANNER=llm
# TypeSafe API key; stays on the server and is redacted from logs.
TYPESAFE_API_KEY=
# Pinned Jev model, e.g. jev-1.13.0. Required for both Jev planners; jev-latest drifts.
JEV_MODEL=
# 1 logs every raw Jev reply (jev.reply), each turn's request (jev.request) and
# the shipped result (jev.result) to the ws server console.
JEV_LOG_REPLIES=

# ── Optional: OpenAI realtime voice ─────────────────────────────────────
# The demo's default voice provider. Skip unless you are working on voice.

# Optional model override; defaults to gpt-realtime-2.1.
OPENAI_REALTIME_MODEL=

# ── Optional: LiveKit voice track ───────────────────────────────────────
# The self-hosted alternative to OpenAI realtime: a Deepgram/Cartesia
# STT/TTS agent worker speaking over LiveKit. All four keys go together.

# Speech-to-text in the LiveKit voice agent (nova-2 model),
# via @livekit/agents-plugin-deepgram
DEEPGRAM_API_KEY=
# Text-to-speech synthesis, via @livekit/agents-plugin-cartesia
# Get your key at: https://play.cartesia.ai/
CARTESIA_API_KEY=
# livekit-server --dev uses these well-known insecure local-only defaults.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Must use the ws:// or wss:// scheme.
LIVEKIT_URL=ws://localhost:7880
# Optional lifetime of minted access tokens; defaults to 15m.
LIVEKIT_TOKEN_TTL=15m

# Fallback ceiling (ms) for emitting a push-to-talk turn when the flush-produced final never arrives (an empty tap). A turn normally emits the instant its flush-final lands, so this only bounds the empty-turn case. Must be a positive number — a non-numeric or non-positive value fails worker startup.
#MAELSTROM_STT_FLUSH_TIMEOUT_MS=500

# ── Reserved ────────────────────────────────────────────────────────────

# Google Gemini API key, reserved for a future engine adapter.
# GOOGLE_API_KEY=

# Anthropic API Key — reserved for an Anthropic provider, not read by the
# demo yet
# ANTHROPIC_API_KEY=
