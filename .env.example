# Typed demo (required)
# Gemini API key used by the demo Engine. Runtime falls back to GEMINI_API_KEY
# when GOOGLE_API_KEY is unset; keep only one real value in your local .env.
# Get a key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional voice: OpenAI realtime
# Used server-side to mint ephemeral browser credentials.
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional model override; defaults to gpt-realtime-2.
OPENAI_REALTIME_MODEL=

# Optional voice: LiveKit cascade
# Deepgram provides speech-to-text transcription.
# Get a key at: https://console.deepgram.com/signup
DEEPGRAM_API_KEY=

# Cartesia provides text-to-speech synthesis.
# Get a key at: https://play.cartesia.ai/
CARTESIA_API_KEY=

# livekit-server --dev uses these well-known insecure local-only defaults.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Must use the ws:// or wss:// scheme.
LIVEKIT_URL=ws://localhost:7880
# Optional lifetime of minted access tokens; defaults to 15m.
LIVEKIT_TOKEN_TTL=15m

# Fallback ceiling (ms) for emitting a push-to-talk turn when the flush-produced final never arrives (an empty tap). A turn normally emits the instant its flush-final lands, so this only bounds the empty-turn case. Must be a positive number — a non-numeric or non-positive value fails worker startup.
#MAELSTROM_STT_FLUSH_TIMEOUT_MS=500
