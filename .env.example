# Google Gemini API Key (for @ai-sdk/google)
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI API Key (for @ai-sdk/openai)
OPENAI_API_KEY=

# Anthropic API Key (for @ai-sdk/anthropic)
ANTHROPIC_API_KEY=

# Deepgram API Key (for @ai-sdk/deepgram)
# Used for: Speech-to-text transcription (Nova-3 model)
DEEPGRAM_API_KEY=

# Cartesia API Key (for TTS)
# Used for: Text-to-speech synthesis (Sonic 3 model)
# Get your key at: https://play.cartesia.ai/
CARTESIA_API_KEY=

# ElevenLabs API Key (for @ai-sdk/elevenlabs) - Optional
# Higher quality TTS voices
ELEVENLABS_API_KEY=

# LiveKit (for the LiveKit adapter voice spike)
# livekit-server --dev uses these well-known insecure defaults (local only)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880
# Lifetime of minted LiveKit access tokens (optional, default 15m)
LIVEKIT_TOKEN_TTL=15m
