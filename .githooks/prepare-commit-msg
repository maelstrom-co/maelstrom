#!/bin/sh
#
# prepare-commit-msg — append a DCO "Signed-off-by" trailer automatically.
#
# Mirrors `git commit -s` so contributors don't have to remember the flag.
# Enable once per clone with:  git config core.hooksPath .githooks
#
# Idempotent: if the committer's sign-off is already present (e.g. you passed
# -s, or you are amending), interpret-trailers leaves it untouched. Skipped for
# merge/squash commits.

set -eu

commit_msg_file="$1"
commit_source="${2:-}"

case "$commit_source" in
	merge|squash)
		exit 0
		;;
esac

# Resolve the effective *committer* identity — honours committer.* config and
# GIT_COMMITTER_* env, so the trailer names whoever `git commit -s` would.
# `git var GIT_COMMITTER_IDENT` prints "Name <email> <timestamp> <tz>"; strip
# the trailing timestamp and timezone to leave "Name <email>".
ident="$(git var GIT_COMMITTER_IDENT 2>/dev/null || true)"
ident="$(printf '%s' "$ident" | sed -E 's/ [0-9]+ [-+][0-9]+$//')"

if [ -z "$ident" ]; then
	echo "prepare-commit-msg: committer identity not set; skipping Signed-off-by" >&2
	exit 0
fi

git interpret-trailers --if-exists addIfDifferent \
	--trailer "Signed-off-by: $ident" --in-place "$commit_msg_file"
