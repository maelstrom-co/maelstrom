---
import LiveDemo from '../islands/demo/LiveDemo.tsx';
---

<section class="demo" id="demo">
  <div class="container">
    <div class="how-head">
      <span class="eyebrow">Experience the engine</span>
      <h2 class="section-h2">See It In Action</h2>
      <p class="section-sub">
        This is <code class="inline-code">@maelstrom-co/react</code> running live,
        not a mockup. The AI responses are pre-recorded so you see a consistent demo.
      </p>
    </div>

    <div class="demo-frame">
      <LiveDemo client:idle />
    </div>
  </div>
</section>
