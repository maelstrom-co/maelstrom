{
  "name": "@maelstrom-co/demo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:voice-assets": "maelstrom-vad-assets public/vad-web",
    "dev": "concurrently --kill-others-on-fail --names ws,vite \"bun --env-file=../../.env run src/server/ws-server.ts\" \"bun run dev:client\"",
    "dev-livekit": "concurrently --kill-others-on-fail --names ws,agent,vite \"bun --env-file=../../.env run src/server/ws-server.ts\" \"bun run dev-agent\" \"bun run dev:client:livekit\"",
    "dev:ws": "bun --env-file=../../.env run src/server/ws-server.ts",
    "dev:client": "bunx nx run @maelstrom-co/demo:serve",
    "dev:client:livekit": "bunx nx run @maelstrom-co/demo:serve -- --mode livekit",
    "dev-agent": "node --conditions=@maelstrom-co/source --env-file-if-exists=../../.env voice-worker.ts start",
    "build": "vite build",
    "build-livekit": "bunx nx run @maelstrom-co/demo:build-livekit",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "deploy": "bunx nx run @maelstrom-co/demo:deploy",
    "verify:hibernation": "bun run scripts/verify-hibernation.ts"
  },
  "nx": {
    "targets": {
      "build": {
        "...": true,
        "dependsOn": [
          "...",
          "^build"
        ]
      },
      "build-livekit": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "...",
          "^build",
          "prepare-voice-assets"
        ],
        "options": {
          "cwd": "apps/demo",
          "command": "vite build --mode livekit"
        }
      },
      "build-hosted": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "cache": true,
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/bun.lock",
          {
            "externalDependencies": [
              "vite"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "VITE_HOSTED=1 vite build"
        }
      },
      "deploy": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build-hosted"
        ],
        "cache": false,
        "options": {
          "cwd": "{projectRoot}",
          "command": "alchemy deploy --stage prod"
        }
      },
      "prepare-voice-assets": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "...",
          {
            "projects": [
              "@maelstrom-co/realtime-vad"
            ],
            "target": "build"
          }
        ],
        "cache": true,
        "inputs": [
          {
            "externalDependencies": [
              "onnxruntime-web",
              "@ricky0123/vad-web"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/public/vad-web"
        ],
        "options": {
          "cwd": "apps/demo",
          "command": "bun run prepare:voice-assets"
        }
      },
      "serve": {
        "...": true,
        "dependsOn": [
          "...",
          "prepare-voice-assets"
        ]
      },
      "dev": {
        "...": true,
        "dependsOn": [
          "...",
          "prepare-voice-assets"
        ]
      },
      "dev-livekit": {
        "...": true,
        "dependsOn": [
          "...",
          "prepare-voice-assets"
        ]
      },
      "typegen": {
        "command": "wrangler types --env-file /dev/null",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "{projectRoot}/wrangler.jsonc",
          "{projectRoot}/src/worker/**/*",
          {
            "externalDependencies": [
              "wrangler"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/worker-configuration.d.ts"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "build",
          "infra-typecheck",
          "typegen"
        ],
        "inputs": [
          "production",
          "^production",
          {
            "externalDependencies": [
              "typescript"
            ]
          },
          "{projectRoot}/wrangler.jsonc",
          "{projectRoot}/tsconfig.json",
          {
            "externalDependencies": [
              "wrangler"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/dist/**/*.d.ts",
          "{projectRoot}/dist/**/*.d.ts.map",
          "{projectRoot}/dist/tsconfig.app.tsbuildinfo",
          "{projectRoot}/out-tsc/vitest/**/*.d.ts",
          "{projectRoot}/out-tsc/vitest/**/*.d.ts.map",
          "{projectRoot}/out-tsc/vitest/tsconfig.spec.tsbuildinfo"
        ]
      },
      "infra-typecheck": {
        "command": "tsc --noEmit -p tsconfig.alchemy.json",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "{projectRoot}/alchemy*.run.ts",
          "{projectRoot}/infra/**/*.ts",
          "{projectRoot}/tsconfig.alchemy.json",
          "{workspaceRoot}/infra/platform/src/**/*.ts",
          "{workspaceRoot}/infra/platform/*.json",
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/bun.lock"
        ]
      }
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@maelstrom-co/client": "workspace:*",
    "@maelstrom-co/engine": "workspace:*",
    "@maelstrom-co/protocol": "workspace:*",
    "@maelstrom-co/react": "workspace:*",
    "@maelstrom-co/react-realtime": "workspace:*",
    "@maelstrom-co/realtime": "workspace:*",
    "@maelstrom-co/realtime-livekit": "workspace:*",
    "@maelstrom-co/realtime-livekit-agent": "workspace:*",
    "@maelstrom-co/realtime-livekit-server": "workspace:*",
    "@maelstrom-co/realtime-openai": "workspace:*",
    "@maelstrom-co/realtime-openai-server": "workspace:*",
    "@maelstrom-co/realtime-protocol": "workspace:*",
    "@maelstrom-co/realtime-vad": "workspace:*",
    "@tanstack/ai": "catalog:",
    "@tanstack/ai-openai": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tanstack/react-store": "catalog:",
    "@tanstack/store": "catalog:",
    "clsx": "^2.1.1",
    "hono": "catalog:",
    "livekit-client": "^2.13.1",
    "lucide-react": "^1.24.0",
    "maplibre-gl": "^5.24.0",
    "nanoid": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "^3.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.111",
    "@effect/platform-node": "4.0.0-rc.111",
    "@maelstrom-co/platform-infra": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/geojson": "^7946.0.16",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "alchemy": "2.0.0-beta.73",
    "concurrently": "^10.0.5",
    "effect": "4.0.0-rc.111",
    "happy-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:"
  }
}
