{
  "name": "@maelstrom-co/demo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names ws,vite \"bun --env-file=../../.env run src/server/ws-server.ts\" \"vite dev --port 3000\"",
    "dev-livekit": "concurrently --kill-others-on-fail --names ws,agent,vite \"bun --env-file=../../.env run src/server/ws-server.ts\" \"bun run dev-agent\" \"vite dev --port 3000 --mode livekit\"",
    "dev:ws": "bun --env-file=../../.env run src/server/ws-server.ts",
    "dev:client": "vite dev --port 3000",
    "dev-agent": "node --conditions=@maelstrom-co/source --env-file-if-exists=../../.env voice-worker.ts start",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "deploy": "VITE_HOSTED=1 bunx nx build @maelstrom-co/demo && wrangler deploy",
    "verify:hibernation": "bun run scripts/verify-hibernation.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@maelstrom-co/client": "workspace:*",
    "@maelstrom-co/engine": "workspace:*",
    "@maelstrom-co/protocol": "workspace:*",
    "@maelstrom-co/react": "workspace:*",
    "@maelstrom-co/react-realtime": "workspace:*",
    "@maelstrom-co/realtime": "workspace:*",
    "@maelstrom-co/realtime-livekit": "workspace:*",
    "@maelstrom-co/realtime-livekit-agent": "workspace:*",
    "@maelstrom-co/realtime-livekit-server": "workspace:*",
    "@maelstrom-co/realtime-server": "workspace:*",
    "@tanstack/ai": "catalog:",
    "@tanstack/ai-gemini": "catalog:",
    "@tanstack/ai-openai": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tanstack/react-store": "catalog:",
    "@tanstack/store": "catalog:",
    "clsx": "^2.1.1",
    "hono": "catalog:",
    "livekit-client": "^2.13.1",
    "lucide-react": "^1.24.0",
    "maplibre-gl": "^5.24.0",
    "nanoid": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "^3.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "@testing-library/react": "catalog:",
    "@types/geojson": "^7946.0.16",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "concurrently": "^9.1.2",
    "happy-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:"
  }
}
