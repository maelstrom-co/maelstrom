{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "skipLibCheck": true,
    "types": ["node", "vite/client"]
  },
  "exclude": [
    "out-tsc",
    "dist",
    ".output",
    ".vinxi",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.test.isolated.ts",
    "src/**/*.test.isolated.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/__tests__/**"
  ],
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "references": [
    {
      "path": "../../packages/protocol-old/tsconfig.lib.json"
    },
    {
      "path": "../../packages/engine-old/tsconfig.lib.json"
    },
    {
      "path": "../../packages/voice-server/tsconfig.lib.json"
    },
    {
      "path": "../../packages/voice/tsconfig.lib.json"
    },
    {
      "path": "../../packages/react-voice/tsconfig.lib.json"
    },
    {
      "path": "../../packages/react/tsconfig.lib.json"
    },
    {
      "path": "../../packages/protocol/tsconfig.lib.json"
    },
    {
      "path": "../../packages/engine/tsconfig.lib.json"
    },
    {
      "path": "../../packages/client/tsconfig.lib.json"
    }
  ]
}
