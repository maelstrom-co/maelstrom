{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "skipLibCheck": true,
    "types": ["node", "vite/client", "geojson"],
    "rootDir": "."
  },
  "exclude": [
    "out-tsc",
    "dist",
    ".output",
    ".vinxi",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.test.isolated.ts",
    "src/**/*.test.isolated.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/__tests__/**",
    "src/**/__test-utils__/**"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "worker-configuration.d.ts",
    "vad-web-dev-plugin.ts"
  ],
  "references": [
    {
      "path": "../../packages/realtime-vad/tsconfig.lib.json"
    },
    {
      "path": "../../packages/realtime-protocol/tsconfig.lib.json"
    },
    {
      "path": "../../packages/realtime-openai-server/tsconfig.lib.json"
    },
    {
      "path": "../../packages/realtime-openai/tsconfig.lib.json"
    },
    {
      "path": "../../packages/realtime-livekit-server/tsconfig.lib.json"
    },
    {
      "path": "../../packages/realtime-livekit-agent/tsconfig.lib.json"
    },
    {
      "path": "../../packages/realtime-livekit/tsconfig.lib.json"
    },
    {
      "path": "../../packages/realtime/tsconfig.lib.json"
    },
    {
      "path": "../../packages/react-realtime/tsconfig.lib.json"
    },
    {
      "path": "../../packages/react/tsconfig.lib.json"
    },
    {
      "path": "../../packages/protocol/tsconfig.lib.json"
    },
    {
      "path": "../../packages/engine/tsconfig.lib.json"
    },
    {
      "path": "../../packages/client/tsconfig.lib.json"
    }
  ]
}
