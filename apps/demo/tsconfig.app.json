{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "skipLibCheck": true,
    "types": ["node", "vite/client"]
  },
  "exclude": ["out-tsc", "dist", ".output", ".vinxi", "node_modules"],
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "references": [
    {
      "path": "../../packages/react-old/tsconfig.lib.json"
    },
    {
      "path": "../../packages/protocol-old/tsconfig.lib.json"
    },
    {
      "path": "../../packages/engine-old/tsconfig.lib.json"
    }
  ]
}
