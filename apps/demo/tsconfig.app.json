{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vinxi/types/client", "vinxi/types/server"]
  },
  "exclude": ["out-tsc", "dist", ".output", ".vinxi", "node_modules"],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts"
  ],
  "references": [
    {
      "path": "../../client/react/tsconfig.lib.json"
    },
    {
      "path": "../../shared/protocol/tsconfig.lib.json"
    },
    {
      "path": "../../server/engine/tsconfig.lib.json"
    }
  ]
}
