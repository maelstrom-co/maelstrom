{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/scripts",
    "tsBuildInfoFile": "out-tsc/scripts/tsconfig.scripts.tsbuildinfo",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "."
  },
  "include": ["scripts/**/*.ts"],
  "references": [
    {
      "path": "../../packages/protocol/tsconfig.lib.json"
    }
  ]
}
