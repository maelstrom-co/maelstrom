{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "maelstrom-playground",
  // Matches the newest date the pinned workerd supports (wrangler 4.115.0 ships
  // workerd 1.20260722.1); a later date would outrun the installed runtime.
  "compatibility_date": "2026-07-22",
  "main": "src/worker/index.ts",
  "routes": [{ "pattern": "demo.maelstrom-ai.co", "custom_domain": true }],
  // Keep both deployment paths explicit: no stable workers.dev URL and no
  // version preview URLs in production (mirrors `workersDev: false`).
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /ws needs the Worker in front of it -- hosted token minting and
    // greeting TTS are browser-direct OpenAI (see worker/index.ts), so there
    // is no /api/mint or demo greeting TTS route on this Worker.
    "run_worker_first": ["/ws"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSION_DO", "class_name": "SessionDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO"] }],
  "env": {
    "preview": {
      "name": "maelstrom-playground-preview",
      "workers_dev": true,
      "routes": [],
      "durable_objects": {
        "bindings": [{ "name": "SESSION_DO", "class_name": "SessionDO" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO"] }]
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  }
}
