{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "maelstrom-playground",
  "compatibility_date": "2026-07-01",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /ws needs the Worker in front of it -- voice token minting is
    // browser-direct OpenAI (see worker/index.ts), so there is no /api/mint route.
    "run_worker_first": ["/ws"]
  },
  "containers": [
    {
      "class_name": "PlaygroundServer",
      "image": "./Dockerfile",
      // Resolved relative to this file's directory (apps/demo) -- wrangler
      // otherwise defaults the build context to the Dockerfile's own
      // directory, which is too shallow for packages/* to resolve via
      // bun's workspace protocol.
      "image_build_context": "../..",
      "max_instances": 5,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PLAYGROUND_SERVER", "class_name": "PlaygroundServer" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlaygroundServer"] }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  }
}
