{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "maelstrom-playground",
  "compatibility_date": "2026-07-01",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /ws needs the Worker in front of it -- voice token minting is
    // browser-direct OpenAI (see worker/index.ts), so there is no /api/mint route.
    "run_worker_first": ["/ws"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSION_DO", "class_name": "SessionDO" }]
  },
  // One v1, not a v1 -> v2 chain: the container-era Worker is deleted
  // outright rather than migrated. `wrangler delete maelstrom-playground`
  // removes it along with its PlaygroundServer namespace, so what deploys
  // afterwards is a Worker with no migration history at all and this array
  // describes it exactly. Nothing was carried forward and nothing needed to
  // be — PlaygroundServer's object ids were shard-0..shard-4, which do not
  // map onto sessionIds, and the playground had no users.
  //
  // PRECONDITION: correct only against a Worker with no v1 already applied.
  // Deployed over the container-era Worker, Cloudflare would see v1 as
  // already applied, skip it, and leave the SESSION_DO binding pointing at a
  // class that has no namespace. Delete first, then deploy — keep those two
  // steps adjacent.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO"] }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  }
}
