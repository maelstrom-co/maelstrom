{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "maelstrom-playground",
  "compatibility_date": "2026-07-01",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /ws needs the Worker in front of it -- voice token minting is
    // browser-direct OpenAI (see worker/index.ts), so there is no /api/mint route.
    "run_worker_first": ["/ws"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSION_DO", "class_name": "SessionDO" }]
  },
  // v1 is retained untouched: the migrations array is a historical ledger,
  // not current state, and past tags are never edited. deleted_classes
  // rather than renamed_classes because PlaygroundServer's object ids
  // (shard-0..shard-4) do not map onto sessionIds — carrying its state
  // forward would be meaningless.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PlaygroundServer"] },
    {
      "tag": "v2",
      "deleted_classes": ["PlaygroundServer"],
      "new_sqlite_classes": ["SessionDO"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  }
}
