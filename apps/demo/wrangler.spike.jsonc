{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // SPIKE config — deliberately separate from wrangler.jsonc so measuring
  // this can never deploy over the real playground.
  "name": "maelstrom-playground-spike",
  // Deliberately BEHIND production's 2026-07-01: the pinned wrangler
  // (4.80.0) ships a workerd that refuses any date past 2026-04-08, so
  // `wrangler dev` cannot boot the real playground Worker locally either.
  // Still past 2026-04-07, which is what web_socket_auto_reply_to_close
  // requires. Upgrading wrangler is its own task.
  "compatibility_date": "2026-04-08",
  // No nodejs_compat: verified the bundle pulls zero node: builtins, and
  // the byte size is identical with and without the flag.
  "main": "src/worker/spike/session-do.ts",
  // No "assets" and no "containers": the point is to weigh the engine's own
  // dependency closure, not the SPA bundle or the container image.
  "durable_objects": {
    "bindings": [{ "name": "SESSION_DO", "class_name": "SessionDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO"] }]
}
