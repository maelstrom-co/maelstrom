{
  "name": "@maelstrom-co/docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prompts:check": "bun tools/prompts/check.ts",
    "skills:install": "bun tools/skills/cli.ts install",
    "skills:update": "bun tools/skills/cli.ts update",
    "skills:remove": "bun tools/skills/cli.ts remove",
    "skills:acceptance": "bun tools/skills/acceptance.ts",
    "skills:eval": "bun tools/skills/migration-cli.ts",
    "prompts:evaluate": "bun prompts/evaluation/index.ts",
    "prompts:evaluation:test": "bun test prompts/evaluation"
  },
  "dependencies": {
    "@astrojs/react": "catalog:",
    "@astrojs/sitemap": "catalog:",
    "@astrojs/starlight": "^0.42.6",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "astro": "catalog:",
    "jsonc-parser": "3.3.1",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@maelstrom-co/platform-infra": "workspace:*",
    "@astrojs/check": "catalog:",
    "@maelstrom-co/client": "workspace:*",
    "@maelstrom-co/connectors": "workspace:*",
    "@maelstrom-co/protocol": "workspace:*",
    "@maelstrom-co/react": "workspace:*",
    "@maelstrom-co/react-realtime": "workspace:*",
    "@maelstrom-co/realtime": "workspace:*",
    "@maelstrom-co/realtime-livekit": "workspace:*",
    "@maelstrom-co/realtime-livekit-server": "workspace:*",
    "@maelstrom-co/realtime-openai": "workspace:*",
    "@maelstrom-co/realtime-openai-server": "workspace:*",
    "@maelstrom-co/realtime-protocol": "workspace:*",
    "@maelstrom-co/realtime-vad": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/react": "^16.1.0",
    "@types/jsdom": "^21.1.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "alchemy": "2.0.0-beta.83",
    "astro-mermaid": "^2.1.0",
    "effect": "catalog:",
    "fflate": "^0.8.3",
    "jsdom": "catalog:",
    "mermaid": "^11.15.0",
    "js-yaml": "^4.3.2",
    "semver": "^7.7.4",
    "satteri": "^0.10.5",
    "starlight-llms-txt": "^0.11.0",
    "starlight-typedoc": "^0.23.0",
    "tailwindcss": "catalog:",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.6.0",
    "typescript": "catalog:",
    "@maelstrom-co/devtools": "workspace:*",
    "@maelstrom-co/react-devtools": "workspace:*",
    "@maelstrom-co/telemetry": "workspace:*",
    "@maelstrom-co/engine": "workspace:*",
    "@maelstrom-co/planner-llm": "workspace:*",
    "@tanstack/ai-openai": "catalog:",
    "@maelstrom-co/devtools-mcp-server": "workspace:*",
    "@maelstrom-co/devtools-protocol": "workspace:*"
  },
  "nx": {
    "implicitDependencies": [
      "@maelstrom-co/protocol",
      "@maelstrom-co/engine",
      "@maelstrom-co/planner-llm",
      "@maelstrom-co/client",
      "@maelstrom-co/connectors",
      "@maelstrom-co/react",
      "@maelstrom-co/realtime",
      "@maelstrom-co/react-realtime",
      "@maelstrom-co/realtime-openai",
      "@maelstrom-co/realtime-openai-server",
      "@maelstrom-co/realtime-openai-live",
      "@maelstrom-co/realtime-openai-live-server",
      "@maelstrom-co/realtime-protocol",
      "@maelstrom-co/realtime-vad",
      "@maelstrom-co/realtime-livekit",
      "@maelstrom-co/realtime-livekit-server",
      "@maelstrom-co/realtime-livekit-agent",
      "@maelstrom-co/devtools",
      "@maelstrom-co/react-devtools",
      "@maelstrom-co/telemetry",
      "@maelstrom-co/devtools-mcp-server",
      "@maelstrom-co/devtools-protocol"
    ],
    "targets": {
      "build": {
        "inputs": [
          "{projectRoot}/astro.config.ts",
          "{projectRoot}/src/**/*",
          "{projectRoot}/public/**/*",
          "{projectRoot}/prompts/**/*",
          "{projectRoot}/skills/**/*",
          "{projectRoot}/tools/prompts/**/*",
          "{projectRoot}/tools/skills/**/*",
          "{workspaceRoot}/docs/realtime-voice-architecture.md",
          "{workspaceRoot}/docs/architecture.md",
          {
            "externalDependencies": [
              "astro"
            ]
          },
          {
            "env": "DOCS_SOURCE_REF"
          },
          {
            "env": "WORKERS_CI_COMMIT_SHA"
          },
          {
            "env": "GITHUB_SHA"
          },
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/bun.lock",
          "production",
          "^production",
          "{projectRoot}/starters/**/*",
          "{workspaceRoot}/LICENSE"
        ]
      },
      "deploy": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "cache": false,
        "options": {
          "cwd": "{projectRoot}",
          "command": "alchemy deploy --stage prod"
        }
      },
      "typecheck": {
        "dependsOn": [
          "build",
          "infra-typecheck"
        ],
        "inputs": [
          "{projectRoot}/astro.config.ts",
          "{projectRoot}/src/**/*",
          "{projectRoot}/public/**/*",
          "{projectRoot}/prompts/**/*",
          "{projectRoot}/skills/**/*",
          "{projectRoot}/tools/prompts/**/*",
          "{projectRoot}/tools/skills/**/*",
          "{projectRoot}/prompts/evaluation/**/*.ts",
          {
            "externalDependencies": [
              "astro"
            ]
          },
          "^production",
          "{projectRoot}/e2e/**/*",
          "{projectRoot}/tsconfig.json",
          "{projectRoot}/tsconfig.e2e.json",
          "{projectRoot}/starters/**/*"
        ]
      },
      "infra-typecheck": {
        "command": "tsc --noEmit -p tsconfig.alchemy.json",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "{projectRoot}/alchemy*.run.ts",
          "{projectRoot}/infra/**/*.ts",
          "{projectRoot}/tsconfig.alchemy.json",
          "{workspaceRoot}/infra/platform/src/**/*.ts",
          "{workspaceRoot}/infra/platform/*.json",
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/bun.lock"
        ]
      },
      "e2e": {
        "dependsOn": [
          "^build"
        ]
      },
      "prompts-check": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/prompts/library/**/*",
          "{projectRoot}/tools/prompts/**/*",
          "{workspaceRoot}/bun.lock"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "bun run prompts:check"
        }
      },
      "test": {
        "parallelism": false,
        "dependsOn": [
          "^build"
        ],
        "command": "bun test src tools/prompts tools/skills prompts/evaluation prompts/acceptance/prepare-trials.test.mjs",
        "inputs": [
          "default",
          "{workspaceRoot}/docs/realtime-voice-architecture.md",
          "{workspaceRoot}/docs/architecture.md"
        ],
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
