{
  "name": "@maelstrom-co/docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "dependencies": {
    "@astrojs/react": "catalog:",
    "@astrojs/sitemap": "catalog:",
    "@astrojs/starlight": "^0.41.5",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "astro": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@maelstrom-co/client": "workspace:*",
    "@maelstrom-co/protocol": "workspace:*",
    "@maelstrom-co/react": "workspace:*",
    "@maelstrom-co/react-realtime": "workspace:*",
    "@maelstrom-co/realtime": "workspace:*",
    "@maelstrom-co/realtime-livekit": "workspace:*",
    "@maelstrom-co/realtime-livekit-server": "workspace:*",
    "@maelstrom-co/realtime-openai": "workspace:*",
    "@maelstrom-co/realtime-openai-server": "workspace:*",
    "@maelstrom-co/realtime-protocol": "workspace:*",
    "@maelstrom-co/realtime-vad": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/react": "^16.1.0",
    "@types/jsdom": "^21.1.7",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "astro-mermaid": "^2.1.0",
    "jsdom": "catalog:",
    "mermaid": "^11.15.0",
    "starlight-llms-txt": "^0.11.0",
    "starlight-typedoc": "^0.23.0",
    "tailwindcss": "catalog:",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.6.0",
    "typescript": "catalog:"
  },
  "nx": {
    "implicitDependencies": [
      "@maelstrom-co/protocol",
      "@maelstrom-co/engine",
      "@maelstrom-co/client",
      "@maelstrom-co/react",
      "@maelstrom-co/realtime",
      "@maelstrom-co/react-realtime",
      "@maelstrom-co/realtime-openai",
      "@maelstrom-co/realtime-openai-server",
      "@maelstrom-co/realtime-protocol",
      "@maelstrom-co/realtime-vad",
      "@maelstrom-co/realtime-livekit",
      "@maelstrom-co/realtime-livekit-server",
      "@maelstrom-co/realtime-livekit-agent"
    ],
    "targets": {
      "build": {
        "inputs": [
          "{projectRoot}/astro.config.ts",
          "{projectRoot}/src/**/*",
          "{projectRoot}/public/**/*",
          {
            "externalDependencies": [
              "astro"
            ]
          },
          {
            "env": "DOCS_SOURCE_REF"
          },
          {
            "env": "WORKERS_CI_COMMIT_SHA"
          },
          {
            "env": "GITHUB_SHA"
          },
          "production",
          "^production"
        ]
      },
      "typecheck": {
        "inputs": [
          "{projectRoot}/astro.config.ts",
          "{projectRoot}/src/**/*",
          "{projectRoot}/public/**/*",
          {
            "externalDependencies": [
              "astro"
            ]
          },
          "^production",
          "{projectRoot}/e2e/**/*",
          "{projectRoot}/tsconfig.json",
          "{projectRoot}/tsconfig.e2e.json"
        ]
      },
      "e2e": {
        "dependsOn": [
          "^build"
        ]
      },
      "test": {
        "command": "bun test src",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
