---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

import { docsRevision, sdkVersions } from '../lib/docs-build-info';
import { markdownPath } from '../lib/markdown-path';
import PostHog from './PostHog.astro';

const { head } = Astro.locals.starlightRoute;
---

{head.map(({ tag: Tag, attrs, content }) => (
  <Tag {...attrs} set:html={content} />
))}
{(Astro.response.status ?? 200) < 400 && Astro.url.pathname !== '/404.html' && (
  <link
    rel="alternate"
    type="text/markdown"
    href={markdownPath(Astro.url.pathname)}
    title="Markdown"
  />
)}
<link
  rel="alternate"
  type="text/plain"
  href="/llms.txt"
  title="LLM documentation index"
/>
<meta name="maelstrom-docs-revision" content={docsRevision} />
<meta name="maelstrom-sdk-versions" content={sdkVersions} />
{/* Runs before first paint so focus mode never flashes open. Inline scripts
    cannot import, so the key and attribute are repeated here; a unit test in
    sidebar-collapse.test.ts fails if they drift. */}
<script is:inline>
  try {
    if (localStorage.getItem('maelstrom-sidebar-collapsed') === 'true') {
      document.documentElement.setAttribute('data-sidebar-collapsed', 'true');
    }
  } catch {
    /* storage unavailable */
  }
</script>
<Font cssVariable="--font-heading" preload />
<Font cssVariable="--font-code" />
<ClientRouter />
<PostHog />
<script>
  import { initSidebarCollapse } from '../lib/sidebar-collapse';
  import { initTocPath, cleanupTocPath } from '../lib/toc-path';

  initTocPath();
  initSidebarCollapse();
  document.documentElement.setAttribute('data-sidebar-collapse-ready', 'true');

  document.addEventListener('astro:before-swap', cleanupTocPath);
  document.addEventListener('astro:after-swap', () => {
    requestAnimationFrame(initTocPath);
  });
</script>
