---
import MaelstromLogo from './MaelstromLogo.astro';
import SidebarToggle from './SidebarToggle.astro';
import VersionBadge from './VersionBadge.astro';
---

<div class="header">
  <div class="header-brand">
    <a href="/" class="site-logo">
      <MaelstromLogo height={18} />
    </a>
    <VersionBadge />
  </div>
</div>

{/* Mounted here, not in Sidebar.astro: the expand button has to outlive the
    sidebar sliding off-screen, and everything in Sidebar.astro renders inside
    .sidebar-pane. */}
<SidebarToggle variant="expand" />

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 0.5rem;
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .site-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  :global(:root[data-theme='dark']) .site-logo {
    color: white;
  }

  :global(:root[data-theme='light']) .site-logo {
    color: #202020;
  }

  .site-logo:hover {
    opacity: 0.8;
  }

  @media (min-width: 50rem) {
    .header {
      display: none;
    }
  }
</style>
