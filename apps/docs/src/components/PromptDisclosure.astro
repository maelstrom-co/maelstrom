---
import { getCollection } from 'astro:content';
import { type PromptEntry, promptLabel } from '../lib/prompt-presentation';

interface Props {
  id: string;
}

const { id } = Astro.props;
const entries = (await getCollection('prompts')) as PromptEntry[];
const entry = entries.find((candidate) => candidate.id === id);
if (!entry) throw new Error(`Unknown canonical prompt: ${id}`);
const label = promptLabel(id);
const encodedBody = Buffer.from(entry.data.body, 'utf8').toString('base64');
---
<details class="prompt-disclosure">
  <summary>View canonical prompt source: {label}</summary>
  <section
    class="prompt-source"
    aria-label={`${label} canonical prompt source`}
    data-prompt-root
    data-prompt-body={encodedBody}
  >
    <div class="source-heading">
      <h3>{label}</h3>
      <button type="button" data-copy-prompt aria-label={`Copy ${label} prompt`}>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="8" y="8" width="12" height="12" rx="2"></rect>
          <path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"></path>
        </svg>
      </button>
    </div>
    <pre><code>{entry.data.body}</code></pre>
    <p data-prompt-status role="status" aria-live="polite"></p>
  </section>
</details>
<script>
  import { initPromptControls } from '../lib/prompt-controls';

  const decodePromptBody = (encoded: string): string =>
    new TextDecoder().decode(
      Uint8Array.from(atob(encoded), (char) => char.charCodeAt(0)),
    );

  document.querySelectorAll<HTMLElement>('.prompt-disclosure [data-prompt-root]').forEach((root) => {
    initPromptControls(root, {
      body: decodePromptBody(root.dataset.promptBody ?? ''),
      filename: 'prompt.md',
    });
  });
</script>
<style>
  .prompt-disclosure { margin-top: .75rem; }
  .prompt-disclosure summary { cursor: pointer; font-weight: 600; }
  .prompt-source { margin-top: .75rem; }
  .source-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .source-heading h3 { margin: 0; font-size: 1rem; }
  button { display: inline-grid; place-items: center; padding: .45rem; border: 1px solid var(--sl-color-gray-5); border-radius: .4rem; background: var(--sl-color-bg); color: var(--sl-color-text); cursor: pointer; }
  button:hover, button:focus-visible { border-color: var(--sl-color-accent); outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  pre { max-height: 32rem; overflow: auto; padding: 1rem; border: 1px solid var(--sl-color-gray-5); border-radius: .5rem; background: var(--sl-color-gray-6); color: var(--sl-color-text); white-space: pre; }
  pre code { white-space: inherit; }
  [data-prompt-status] { min-height: 1.4em; margin: .5rem 0 0; }
</style>
