---
interface Props {
  variant: 'collapse' | 'expand';
}

const { variant } = Astro.props;
const isCollapse = variant === 'collapse';
const label = isCollapse ? 'Collapse sidebar' : 'Expand sidebar';
---

<button
  type="button"
  class:list={['sidebar-toggle', `sidebar-toggle--${variant}`]}
  data-sidebar-toggle={variant}
  aria-controls="starlight__sidebar"
  aria-expanded="true"
  aria-label={label}
  aria-keyshortcuts="Meta+B Control+B"
  title={`${label} (Ctrl+B or Cmd+B)`}
>
  <svg
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect width="18" height="18" x="3" y="3" rx="2"></rect>
    <path d="M9 3v18"></path>
    {isCollapse ? <path d="m16 15-3-3 3-3" /> : <path d="m14 9 3 3-3 3" />}
  </svg>
</button>

<style>
  /* Focus mode is desktop-only; below 50rem Starlight's drawer is the nav. */
  .sidebar-toggle {
    display: none;
  }

  @media (min-width: 50rem) {
    .sidebar-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.75rem;
      height: 1.75rem;
      padding: 0;
      border: 1px solid transparent;
      border-radius: 0.375rem;
      background: transparent;
      color: var(--sl-color-gray-3);
      cursor: pointer;
      transition: color 0.15s, background 0.15s, border-color 0.15s;
    }

    .sidebar-toggle:hover {
      color: var(--sl-color-white);
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.1);
    }

    :global([data-theme='light']) .sidebar-toggle:hover {
      color: #0a1e35;
      background: rgba(10, 30, 53, 0.05);
      border-color: rgba(10, 30, 53, 0.1);
    }

    /* Exactly one button matches the current state; the other stays in the DOM
       so the focus hand-off always has a target. */
    :global(:root:not([data-sidebar-collapsed])) .sidebar-toggle--expand {
      display: none;
    }

    :global(:root[data-sidebar-collapsed]) .sidebar-toggle--collapse {
      display: none;
    }

    /* Starlight renders the header, and so this button, on splash pages too —
       where hasSidebar is false and aria-controls points at nothing. Declared
       last so it wins over the state pair above at equal specificity. */
    :global(:root:not([data-has-sidebar])) .sidebar-toggle {
      display: none;
    }

    /* The expand button is mounted in the header wrapper, which is inert on
       desktop so its zero-height bar cannot swallow clicks. Opt this one child
       back in. */
    .sidebar-toggle--expand {
      position: fixed;
      inset-block-start: 0.75rem;
      inset-inline-start: 0.75rem;
      pointer-events: auto;
      background: var(--sl-color-bg-sidebar);
      border-color: rgba(255, 255, 255, 0.08);
    }

    :global([data-theme='light']) .sidebar-toggle--expand {
      border-color: rgba(10, 30, 53, 0.1);
    }
  }

  /* The header wrapper that mounts .sidebar-toggle--expand stays in the DOM on
     desktop (it is no longer display: none) so the button has a mount point;
     without this rule its fixed icon can print onto the page while collapsed. */
  @media print {
    .sidebar-toggle {
      display: none;
    }
  }
</style>
