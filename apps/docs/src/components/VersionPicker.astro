---
import docs from 'virtual:maelstrom/docs-versions';

import { versionOptions } from '../lib/docs-versions';

const options = versionOptions(docs, Astro.locals.starlightRoute.id);
---

<label class="version-picker">
  <span class="sr-only">Docs version</span>
  <select data-docs-version-picker aria-label="Docs version">
    {options.map((option) => (
      <option
        value={option.href}
        data-version={option.version}
        selected={option.current}
      >
        {option.label}
      </option>
    ))}
  </select>
</label>

<style>
  .version-picker select {
    width: 100%;
    padding: 0.375rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    font-size: 0.8125rem;
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  const bind = () => {
    for (const select of document.querySelectorAll<HTMLSelectElement>(
      'select[data-docs-version-picker]',
    )) {
      select.onchange = () => {
        void navigate(select.value);
      };
    }
  };
  bind();
  document.addEventListener('astro:page-load', bind);
</script>
