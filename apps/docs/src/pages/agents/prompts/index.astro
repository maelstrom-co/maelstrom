---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
  type PromptEntry,
  promptLabel,
  sortPrompts,
} from '../../../lib/prompt-presentation';

const prompts = sortPrompts((await getCollection('prompts')) as PromptEntry[]);
const base = import.meta.env.BASE_URL;
---
<StarlightPage
  frontmatter={{
    title: 'Agent prompts',
    description: 'Browse the current version of each canonical Maelstrom prompt.',
  }}
>
  <main class="prompt-index">
    <nav aria-label="Breadcrumb">
      <a href={base}>Maelstrom docs</a> / Agent prompts
    </nav>
    <header>
      <p class="eyebrow">AGENT PROMPTS</p>
      <p>
        Browse the current version of each canonical prompt. Prompt content is
        available as Markdown for copying or download.
      </p>
    </header>
    <ul class="prompt-list">
      {
        prompts.map(({ id, data }) => (
          <li>
            <a href={`${base}agents/prompts/${encodeURIComponent(id)}/`}>
              <span class="prompt-name">{promptLabel(id)}</span>
              <span class="prompt-id">{id}</span>
              <span class="prompt-meta">v{data.metadata.prompt_version}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</StarlightPage>
<style>
  .prompt-index { max-width: 58rem; margin: 0 auto; }
  nav, .prompt-id, .eyebrow { color: var(--sl-color-gray-2); font-size: .9rem; }
  header { margin: 2rem 0; max-width: 44rem; }
  .eyebrow { letter-spacing: .12em; font-weight: 700; }
  .prompt-list { display: grid; gap: .75rem; margin: 0; padding: 0; list-style: none; }
  .prompt-list a { display: grid; grid-template-columns: 1fr auto; gap: .15rem 1rem; padding: 1rem 1.25rem; border: 1px solid var(--sl-color-gray-5); border-radius: .75rem; background: var(--sl-color-bg); color: var(--sl-color-text); text-decoration: none; }
  .prompt-list a:hover, .prompt-list a:focus-visible { border-color: var(--sl-color-accent); outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .prompt-name { font-weight: 650; }
  .prompt-id { grid-column: 1; overflow-wrap: anywhere; }
  .prompt-meta { grid-column: 2; grid-row: 1 / 3; align-self: center; white-space: nowrap; }
</style>
