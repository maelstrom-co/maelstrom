---
import { getCollection } from 'astro:content';
import {
  type PromptEntry,
  promptLabel,
  sortPrompts,
} from '../../../lib/prompt-presentation';

const prompts = sortPrompts((await getCollection('prompts')) as PromptEntry[]);
const base = import.meta.env.BASE_URL;
---
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Canonical Maelstrom agent prompts." /><title>Agent prompts | Maelstrom</title></head>
  <body>
    <main class="page">
      <nav aria-label="Breadcrumb"><a href={base}>Maelstrom docs</a> / Agent prompts</nav>
      <header><p class="eyebrow">AGENT PROMPTS</p><h1>Maelstrom prompts</h1><p>Browse the current version of each canonical prompt. Prompt content is available as Markdown for copying or download.</p></header>
      <ul class="prompt-list">
        {prompts.map(({ id, data }) => <li><a href={`${base}agents/prompts/${encodeURIComponent(id)}/`}><span class="prompt-name">{promptLabel(id)}</span><span class="prompt-id">{id}</span><span class="prompt-meta">v{data.metadata.prompt_version}</span></a></li>)}
      </ul>
    </main>
  </body>
</html>
<style>
  :global(body) { margin: 0; color: #20232a; background: #f8f9fb; font: 1rem/1.6 system-ui, sans-serif; }
  .page { box-sizing: border-box; max-width: 58rem; margin: 0 auto; padding: clamp(1.25rem, 5vw, 3rem); }
  nav, .prompt-id, .eyebrow { color: #566174; font-size: .9rem; }
  header { margin: 3rem 0 2rem; max-width: 44rem; } h1 { margin: .3rem 0; font-size: clamp(2rem, 6vw, 3.2rem); line-height: 1.12; }
  .eyebrow { letter-spacing: .12em; font-weight: 700; }
  .prompt-list { display: grid; gap: .75rem; margin: 0; padding: 0; list-style: none; }
  .prompt-list a { display: grid; grid-template-columns: 1fr auto; gap: .15rem 1rem; padding: 1rem 1.25rem; border: 1px solid #d7dce5; border-radius: .75rem; background: white; color: inherit; text-decoration: none; }
  .prompt-list a:hover, .prompt-list a:focus-visible { border-color: #5265c5; outline: 2px solid #5265c5; outline-offset: 2px; }
  .prompt-name { font-weight: 650; } .prompt-id { grid-column: 1; overflow-wrap: anywhere; } .prompt-meta { grid-column: 2; grid-row: 1 / 3; align-self: center; white-space: nowrap; }
</style>
