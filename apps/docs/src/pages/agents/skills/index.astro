---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { resolveDocsSourceRef } from '../../../lib/docs-source-links.js';

const sourceRef = resolveDocsSourceRef(process.env);
const sourceTree = `https://github.com/maelstrom-co/maelstrom/tree/${sourceRef}/apps/docs/skills`;
const sourceFile = `https://github.com/maelstrom-co/maelstrom/blob/${sourceRef}/apps/docs/skills/README.md`;
---
<StarlightPage
  frontmatter={{
    title: 'Agent skills',
    description: 'Portable Maelstrom lead skills and their conditional references.',
  }}
>
  <div class="skill-index">
    <nav aria-label="Breadcrumb">
      <a href="/agents/prompts/">Agent prompts</a> / Agent skills
    </nav>
    <header>
      <p class="eyebrow">AGENT SKILLS</p>
      <h1>Portable workflow skills</h1>
      <p>
        Choose one lead skill for a task. It owns the workflow and points to
        supporting references only when they apply. Skills do not assemble or
        change standalone prompt bodies.
      </p>
    </header>
    <section aria-labelledby="obtain-heading">
      <h2 id="obtain-heading">Obtain the complete bundle</h2>
      <p>
        Download the complete, revision-matched skills bundle generated from
        this docs build. It contains the entire <code>apps/docs/skills/</code>
        tree and the exact canonical voice architecture and ADR Markdown needed
        by the optional voice skill. Preserve the paths when extracting or
        copying the bundle; its relative Markdown links resolve without
        installation.
      </p>
      <ul>
        <li><a href="/agents/skills/bundle.zip" download="maelstrom-agent-skills.zip">Download complete skills bundle for this docs build</a></li>
        <li><a href={sourceTree}>Browse the GitHub skills source tree</a></li>
        <li><a href={sourceFile}>Browse the README source</a></li>
      </ul>
      <p>
        GitHub links are for source browsing only and may refer to a mutable
        branch when build revision metadata is unavailable. The downloaded
        bundle is generated from the exact sources used by this docs build.
        Extract or copy <code>apps/docs/skills/</code> into the coding agent's
        supported skill directory, preserving each <code>SKILL.md</code> and
        <code>references/</code> path. No registry, installer, or global
        configuration is provided here. Follow the selected agent's own skill
        discovery instructions.
      </p>
    </section>
    <p class="prompt-link">
      Looking for a standalone instruction instead? Browse the
      <a href="/agents/prompts/">canonical prompt library</a>.
    </p>
  </div>
</StarlightPage>
<style>
  .skill-index { max-width: 58rem; margin: 0 auto; }
  nav, .eyebrow { color: var(--sl-color-gray-2); font-size: .9rem; }
  header { margin: 2rem 0; max-width: 46rem; }
  .eyebrow { letter-spacing: .12em; font-weight: 700; }
  section { padding: 1.25rem; border: 1px solid var(--sl-color-gray-5); border-radius: .75rem; background: var(--sl-color-bg); }
  li { margin: .6rem 0; }
  .prompt-link { margin-top: 2rem; }
</style>
