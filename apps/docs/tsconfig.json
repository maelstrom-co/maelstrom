{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["bun", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.astro",
    "tools/prompts/**/*.ts",
    "prompts/evaluation/**/*.ts",
    "tools/skills/**/*.ts",
    "astro.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "tools/prompts/**/*.test.ts",
    "prompts/evaluation/**/*.test.ts",
    "tools/skills/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../../packages/planner-llm"
    },
    {
      "path": "../../packages/engine"
    },
    {
      "path": "../../packages/telemetry"
    },
    {
      "path": "../../packages/react-devtools"
    },
    {
      "path": "../../packages/devtools"
    },
    {
      "path": "../../packages/realtime-vad"
    },
    {
      "path": "../../packages/connectors"
    },
    {
      "path": "../../packages/realtime-openai"
    },
    {
      "path": "../../packages/realtime-openai-server"
    },
    {
      "path": "../../packages/client"
    },
    {
      "path": "../../packages/realtime-protocol"
    },
    {
      "path": "../../packages/realtime-livekit-server"
    },
    {
      "path": "../../packages/protocol"
    },
    {
      "path": "../../packages/realtime-livekit"
    },
    {
      "path": "../../packages/realtime"
    },
    {
      "path": "../../packages/react-realtime"
    },
    {
      "path": "../../packages/react"
    },
    {
      "path": "../../infra/platform"
    },
    {
      "path": "./tsconfig.e2e.json"
    }
  ]
}
