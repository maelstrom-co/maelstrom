{
  "name": "@maelstrom-co/www",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test src",
    "test:watch": "bun test src --watch"
  },
  "dependencies": {
    "@astrojs/react": "catalog:",
    "@astrojs/sitemap": "catalog:",
    "@maelstrom-co/client": "workspace:*",
    "@maelstrom-co/protocol": "workspace:*",
    "@maelstrom-co/react": "workspace:*",
    "@radix-ui/react-scroll-area": "catalog:",
    "astro": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "resend": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@astrojs/cloudflare": "catalog:",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:"
  },
  "nx": {
    "targets": {
      "typegen": {
        "command": "wrangler types --env-file /dev/null",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "{projectRoot}/wrangler.jsonc",
          {
            "externalDependencies": [
              "wrangler"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/worker-configuration.d.ts"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "build",
          "typegen"
        ],
        "inputs": [
          "{projectRoot}/astro.config.ts",
          "{projectRoot}/src/**/*",
          "{projectRoot}/public/**/*",
          {
            "externalDependencies": [
              "astro"
            ]
          },
          "^default",
          "{projectRoot}/wrangler.jsonc",
          "{projectRoot}/tsconfig.json",
          {
            "externalDependencies": [
              "wrangler"
            ]
          }
        ]
      }
    }
  }
}
