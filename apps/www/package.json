{
  "name": "@maelstrom-co/www",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test src",
    "test:watch": "bun test src --watch"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "catalog:",
    "@astrojs/sitemap": "catalog:",
    "@effect/sql-d1": "catalog:",
    "@maelstrom-co/client": "workspace:*",
    "@maelstrom-co/platform-infra": "workspace:*",
    "@maelstrom-co/protocol": "workspace:*",
    "@maelstrom-co/react": "workspace:*",
    "@radix-ui/react-scroll-area": "catalog:",
    "astro": "catalog:",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@astrojs/check": "catalog:",
    "@astrojs/cloudflare": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "alchemy": "2.0.0-beta.81",
    "effect": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:"
  },
  "nx": {
    "targets": {
      "build": {
        "...": true,
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/bun.lock",
          {
            "env": "CLOUDFLARE_ENV"
          },
          {
            "env": "PUBLIC_PLAYGROUND_URL"
          },
          {
            "env": "PUBLIC_TURNSTILE_SITE_KEY"
          },
          {
            "env": "PUBLIC_TURNSTILE_ENVIRONMENT"
          }
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/.wrangler/deploy"
        ]
      },
      "deploy": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "cache": false,
        "options": {
          "cwd": "{projectRoot}",
          "command": "alchemy deploy --stage prod"
        }
      },
      "typecheck": {
        "dependsOn": [
          "build",
          "infra-typecheck"
        ],
        "inputs": [
          "{projectRoot}/astro.config.ts",
          "{projectRoot}/src/**/*",
          "{projectRoot}/public/**/*",
          {
            "externalDependencies": [
              "astro"
            ]
          },
          "^default",
          "{projectRoot}/tsconfig.json"
        ]
      },
      "infra-typecheck": {
        "command": "tsc --noEmit -p tsconfig.alchemy.json",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "{projectRoot}/alchemy*.run.ts",
          "{projectRoot}/infra/**/*.ts",
          "{projectRoot}/tsconfig.alchemy.json",
          "{workspaceRoot}/infra/platform/src/**/*.ts",
          "{workspaceRoot}/infra/platform/*.json",
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/bun.lock"
        ]
      }
    }
  }
}
