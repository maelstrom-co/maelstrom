---
import { WAITLIST_DISCORD_INVITE_URL } from '@maelstrom-co/platform-infra/waitlist-contract';

interface Props {
  source: 'navigation' | 'beta_section' | 'footer_community' | 'launch_blog';
  class?: string;
}

const { source, class: className } = Astro.props;
---

<a
  href={WAITLIST_DISCORD_INVITE_URL}
  class={className}
  data-beta-discord-source={source}
  target="_blank"
  rel="noopener noreferrer"
>
  <slot />
</a>

<script>
  import { captureWebsiteEvent } from '../lib/posthog';

  document.querySelectorAll<HTMLAnchorElement>('[data-beta-discord-source]').forEach((link) => {
    link.addEventListener('click', () => {
      captureWebsiteEvent('beta_discord_invite_clicked', {
        source: link.dataset.betaDiscordSource ?? 'unknown',
      });
    });
  });
</script>
