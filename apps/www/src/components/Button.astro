---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'secondary-light';
  class?: string;
}

const { href, variant = 'primary', class: className = '' } = Astro.props;
const Element = href ? 'a' : 'button';

const baseClasses = 'inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-full font-semibold text-base transition-all duration-300 ease-in-out cursor-pointer';
const variants = {
  primary: 'bg-gradient-to-r from-blue via-blue/90 to-cyan/70 text-white hover:shadow-[0_0_40px_rgba(0,102,255,0.5)] hover:scale-[1.03] active:scale-[0.98]',
  secondary: 'border border-white/20 text-text hover:border-cyan/40 hover:text-cyan hover:shadow-[0_0_30px_rgba(0,240,255,0.12)] active:scale-[0.98]',
  'secondary-light': 'border border-text-dark/20 text-text-dark hover:border-blue/40 hover:text-blue hover:shadow-[0_0_20px_rgba(0,102,255,0.15)]',
};
---

<Element href={href} type={href ? undefined : 'button'} class:list={[baseClasses, variants[variant], className]}>
  <slot />
</Element>
