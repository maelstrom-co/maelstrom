---
const navLinks = [
  { label: 'How It Works', href: '#how-it-works' },
  { label: 'Demo', href: '#demo' },
  { label: 'Docs', href: '#' },
];
---

<nav class="site-nav fixed top-0 inset-x-0 z-50 transition-all duration-300" aria-label="Main navigation">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <svg width="24" height="24" viewBox="0 0 48 48" aria-hidden="true" class="text-cyan opacity-80 group-hover:opacity-100 transition-opacity">
        <path
          d="M24 24 C24 20, 28 18, 30 20 C32 22, 30 27, 26 28 C22 29, 17 26, 17 22 C17 17, 22 13, 27 13 C33 13, 37 18, 37 24 C37 31, 31 36, 24 36 C16 36, 11 30, 11 23 C11 15, 17 9, 25 9"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        />
        <circle cx="24" cy="24" r="1.5" fill="currentColor" />
      </svg>
      <span class="font-display font-bold text-lg text-text">Maelstrom</span>
    </a>

    <!-- Center links (desktop) -->
    <div class="hidden md:flex items-center gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="px-3 py-1.5 rounded-lg text-sm font-medium text-text-muted hover:text-text hover:bg-white/5 transition-colors duration-200"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Right side -->
    <div class="flex items-center gap-2">
      <a
        href="https://github.com/maelstrom-co"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm font-medium text-text-muted hover:text-text hover:bg-white/5 transition-all duration-200"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        <span class="hidden sm:inline">GitHub</span>
      </a>
      <a
        href="#cloud"
        class="flex items-center px-4 py-1.5 rounded-full text-sm font-medium bg-cyan/10 text-cyan border border-cyan/20 hover:bg-cyan/15 hover:border-cyan/30 hover:shadow-[0_0_20px_rgba(0,240,255,0.1)] transition-all duration-300"
      >
        Join Waitlist
      </a>
    </div>
  </div>
</nav>

<style>
  .site-nav {
    background: rgba(5, 8, 16, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    animation: nav-solidify linear both;
    animation-timeline: scroll();
    animation-range: 0px 300px;
  }

  @keyframes nav-solidify {
    from {
      background: rgba(5, 8, 16, 0.2);
      border-bottom-color: transparent;
    }
    to {
      background: rgba(5, 8, 16, 0.9);
      border-bottom-color: rgba(255, 255, 255, 0.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav {
      background: rgba(5, 8, 16, 0.8);
      animation: none;
    }
  }
</style>
