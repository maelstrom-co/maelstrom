---
import { isWaitlistProductionHostname } from '@maelstrom-co/platform-infra/waitlist-contract';
import Nav from '../components/Nav.astro';
import PostHog from '../components/PostHog.astro';
import ShaderBackground from '../components/ShaderBackground.astro';

interface Props {
  title: string;
  description?: string;
  analytics?: boolean;
  canonical?: string;
  image?: string;
  keywords?: string[];
  article?: { date: Date; author: string; authorUrl: string; labels: string[] };
}

const {
  title,
  description = "An open-source library for AI-orchestrated UI: a model arranges, resizes, and triggers the components you built — in real time, from the user's intent. It never invents new ones.",
  analytics = true,
  canonical,
  image,
  keywords,
  article,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site);
const ogImage = image ?? new URL('/og.png', Astro.site);
const isPreview =
  import.meta.env.PROD && !isWaitlistProductionHostname(Astro.url.hostname);

// Escape every `<` in the JSON-LD so a description containing `</script>`
// can't break out of the inlined block; the escaped form parses back to `<`.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Maelstrom',
      url: 'https://maelstrom-ai.co',
      logo: new URL('/favicon.svg', Astro.site).href,
      sameAs: ['https://github.com/maelstrom-co', 'https://x.com/maelstrom_co'],
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Maelstrom',
      description,
      url: 'https://maelstrom-ai.co',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
  ],
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords.join(', ')} />}
    {article && <meta name="author" content={article.author} />}

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.date.toISOString()} />}
    {article && <meta property="article:author" content={article.authorUrl} />}
    {article?.labels.map((label) => <meta property="article:tag" content={label} />)}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Maelstrom" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@maelstrom_co" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={jsonLd} />

    {analytics && <PostHog />}
  </head>
  <body class="bg-abyss text-text font-sans antialiased overflow-x-clip">
    <ShaderBackground />
    <div class="noise" aria-hidden="true" />
    <Nav />
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
