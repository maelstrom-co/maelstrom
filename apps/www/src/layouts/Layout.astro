---
import Nav from '../components/Nav.astro';
import PostHog from '../components/PostHog.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Open-source framework where language models orchestrate your UI. Voice-driven interfaces, dynamic layouts, and intelligent component arrangement — all from natural language.' } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const isPreview = import.meta.env.PROD && !Astro.url.hostname.endsWith('maelstrom-ai.co');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Maelstrom" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@maelstrom_co" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "name": "Maelstrom",
          "url": "https://maelstrom-ai.co",
          "logo": new URL('/favicon.svg', Astro.site).href,
          "sameAs": [
            "https://github.com/maelstrom-co",
            "https://x.com/maelstrom_co"
          ]
        },
        {
          "@type": "SoftwareApplication",
          "name": "Maelstrom",
          "description": description,
          "url": "https://maelstrom-ai.co",
          "applicationCategory": "DeveloperApplication",
          "operatingSystem": "Any",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          }
        }
      ]
    })} />

    <PostHog />
  </head>
  <body class="bg-abyss text-text font-sans antialiased overflow-x-clip">
    <div class="noise-overlay" aria-hidden="true" />
    <Nav />
    <slot />

    <script>
      // Hero entrance — trigger on page load (not scroll-driven)
      requestAnimationFrame(() => {
        document.querySelectorAll('[data-hero-reveal]').forEach((el) => {
          el.classList.add('revealed');
        });
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  html {
    scroll-behavior: smooth;
    overflow-x: clip;
  }

  body {
    background: var(--color-abyss);
  }
</style>
