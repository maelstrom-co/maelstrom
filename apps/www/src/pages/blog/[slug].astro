---
import { type CollectionEntry, getCollection, render } from 'astro:content';

import Layout from '../../layouts/Layout.astro';
import { blogPath, productionUrl, sortPosts } from '../../lib/blog';
import { parsePreviewNarrationBase } from '../../lib/blog-narration-preview';

import '../../styles/blog.css';

export async function getStaticPaths() {
  return sortPosts(await getCollection('blog')).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, image, keywords, author, authorUrl, labels } =
  post.data;
const previewNarration = parsePreviewNarrationBase(
  import.meta.env.PUBLIC_BLOG_NARRATION_PREVIEW_BASE,
);
---

<Layout
  title={`${title} — Maelstrom`}
  description={description}
  canonical={productionUrl(blogPath(post.id))}
  image={productionUrl(image)}
  keywords={keywords}
  article={{ date, author, authorUrl, labels }}
>
  <main
    class="container blog-page"
    data-narration-release={import.meta.env.PUBLIC_BLOG_NARRATION_RELEASE}
    data-narration-voice={import.meta.env.PUBLIC_BLOG_NARRATION_VOICE_HASH}
  >
    <a href={blogPath()}>← All posts</a>
    <article>
      <header>
        <h1 data-narration-text>{title}</h1>
        <p data-narration-text>{description}</p>
        <p>
          <time datetime={date.toISOString()}>
            {date.toISOString().slice(0, 10)}
          </time>{' '}
          · By <a href={authorUrl}>{author}</a>
        </p>
        <ul class="blog-labels" aria-label="Labels">
          {labels.map((label) => (
            <li>{label}</li>
          ))}
        </ul>
      </header>
      <section
        class="blog-narration"
        aria-label="Article narration"
        data-narration-player={
          previewNarration
            ? new URL(
                `${blogPath(post.id).slice(1)}narration.json`,
                previewNarration,
              ).href
            : `${blogPath(post.id)}narration.json`
        }
        data-narration-assets={previewNarration?.href}
        data-narration-voice={import.meta.env.PUBLIC_BLOG_NARRATION_VOICE_HASH}
        hidden
      >
        <button type="button">Play narration</button>
        <label class="sr-only" for="narration-position">
          Narration position
        </label>
        <input
          type="range"
          id="narration-position"
          min="0"
          value="0"
          step="any"
        />
        <output for="narration-position" aria-hidden="true"></output>
        <audio preload="metadata"></audio>
        <span role="status"></span>
      </section>
      <div class="blog-prose" data-narration-text>
        <Content />
      </div>
    </article>
  </main>
</Layout>

<script>
  import '../../lib/blog-narration-player';
</script>
