---
import Layout from '../layouts/Layout.astro';
import Community from '../sections/Community.astro';
import Demo from '../sections/Demo.astro';
import FAQ from '../sections/FAQ.astro';
import Footer from '../sections/Footer.astro';
import Hero from '../sections/Hero.astro';
import HowItWorks from '../sections/HowItWorks.astro';
---

<Layout
  title="Maelstrom — intent-driven apps"
  description="An open-source framework for building intent-driven apps. Users describe what they want by text, or by voice with an optional integration. Your components declare their variants and actions, and Maelstrom selects, arranges, and invokes them around the user's goal."
>
  <main>
    <Hero />

    <HowItWorks />

    <Demo />

    <Community />

    <FAQ />
  </main>

  <Footer />
</Layout>
