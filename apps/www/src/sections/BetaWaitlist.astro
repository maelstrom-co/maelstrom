---
import BetaDiscordLink from '../components/BetaDiscordLink.astro';

const BETA_PROGRAM = [
  {
    title: 'Build something real',
    body: 'Use Maelstrom in your own React project and test it against real product requirements.',
  },
  {
    title: 'Work with the maintainers',
    body: 'Share bugs, rough edges, and missing capabilities directly with the team building the library.',
  },
  {
    title: 'Shape the open source API',
    body: 'Help us make the developer experience solid before the first public release.',
  },
];
---

<section class="cloud" id="waitlist">
  <div class="container">
    <div class="how-head">
      <span class="eyebrow">Open source private beta</span>
      <h2 class="section-h2">Help shape Maelstrom</h2>
      <p class="section-sub">
        We are inviting React engineers to test the Maelstrom library in real
        projects and help us prepare it for public release.
      </p>
    </div>

    <div class="cloud-grid">
      {BETA_PROGRAM.map((item, i) => (
        <div class="cloud-card">
          <div class="cloud-icon">
            {i === 0 && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.8-3.8a6 6 0 0 1-7.9 7.9l-7 7a2.1 2.1 0 0 1-3-3l7-7a6 6 0 0 1 7.9-7.9l-3.8 3.8z" />
              </svg>
            )}
            {i === 1 && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
                <path d="M8 9h8M8 13h5" />
              </svg>
            )}
            {i === 2 && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 3 14.8 8.7 21 9.6l-4.5 4.4 1.1 6.2-5.6-2.9-5.6 2.9 1.1-6.2L3 9.6l6.2-.9L12 3z" />
              </svg>
            )}
          </div>
          <h3 class="cloud-title">{item.title}</h3>
          <p class="cloud-body">{item.body}</p>
          <div class="cloud-meta mono">0{i + 1} / 03</div>
        </div>
      ))}
    </div>

    <div class="waitlist-card">
      <div class="waitlist-inner">
        <div>
          <h3 class="waitlist-title">Become a beta tester</h3>
          <p class="waitlist-sub">
            Join our Discord community for the beta role and instructions to
            request GitHub access.
          </p>
        </div>
        <BetaDiscordLink source="beta_section" class="btn btn-primary beta-discord-cta">
          Join the beta community on Discord
        </BetaDiscordLink>
      </div>
    </div>
  </div>
</section>
