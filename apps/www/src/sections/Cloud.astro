---
import SectionWrapper from '../components/SectionWrapper.astro';
import WaitlistForm from '../islands/WaitlistForm.tsx';
import { cloudFeatures } from '../data/content';
---

<SectionWrapper id="cloud" class="py-20 md:py-44 px-6 relative">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-cyan/[0.02] rounded-full blur-[120px]" />
    <div class="absolute top-1/3 left-1/4 w-[300px] h-[300px] bg-violet/[0.015] rounded-full blur-[100px]" />
  </div>

  <div class="relative max-w-3xl mx-auto text-center">
    <p class="section-kicker mb-5">Coming Soon</p>
    <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-text mb-6">
      Maelstrom Cloud
    </h2>
    <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-14 max-w-2xl mx-auto">
      Managed orchestration engine. Deploy AI-driven interfaces without managing infrastructure.
    </p>

    <!-- Feature teasers -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-14" data-scroll-reveal>
      {cloudFeatures.map((f) => (
        <div
          class="px-5 py-5 rounded-xl text-center"
          style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05);"
        >
          <div
            class="w-9 h-9 rounded-lg mx-auto mb-3 flex items-center justify-center"
            style="background: rgba(0, 240, 255, 0.06); border: 1px solid rgba(0, 240, 255, 0.1);"
          >
            <svg class="w-4 h-4 text-cyan/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d={f.icon} />
            </svg>
          </div>
          <div class="text-sm text-text/80 font-medium mb-1">{f.title}</div>
          <div class="text-xs text-text-muted/60 leading-relaxed">{f.desc}</div>
        </div>
      ))}
    </div>

    <WaitlistForm client:visible />
  </div>
</SectionWrapper>
