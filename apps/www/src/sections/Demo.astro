---
import SectionWrapper from '../components/SectionWrapper.astro';
import LiveDemo from '../islands/demo/LiveDemo.tsx';
---

<SectionWrapper id="demo" class="py-32 md:py-44 px-6 relative">
  <!-- Section atmospheric glow -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] bg-cyan/[0.015] rounded-full blur-[150px]" />
    <div class="absolute bottom-1/4 left-1/3 w-[400px] h-[400px] bg-blue/[0.02] rounded-full blur-[120px]" />
  </div>

  <div class="relative max-w-5xl mx-auto">
    <div class="text-center mb-16" data-scroll-reveal>
      <p class="section-kicker mb-4">Live Demo</p>
      <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-text mb-6">
        See It In Action
      </h2>
      <p class="text-lg md:text-xl text-text-muted max-w-2xl mx-auto leading-relaxed">
        This is <code class="text-cyan/70 text-[0.9em]">@maelstrom-co/react</code> running live — not a mockup. The layout engine is real. The AI responses are pre-recorded so you see a consistent demo.
      </p>
    </div>
    <div data-scroll-reveal>
      <LiveDemo client:visible />
    </div>
  </div>
</SectionWrapper>
