---
import { PLAYGROUND_URL } from '../data/playground-url.ts';
import LiveDemo from '../islands/demo/LiveDemo.tsx';
---

<section class="demo" id="demo">
  <div class="container">
    <div class="how-head">
      <span class="eyebrow">Experience the engine</span>
      <h2 class="section-h2">See It In Action</h2>
      <p class="section-sub">
        This is <code class="inline-code">@maelstrom-co/react</code> running live,
        not a mockup. The AI responses are pre-recorded so you see a consistent demo.
      </p>
    </div>

    <div class="demo-frame">
      <LiveDemo client:idle={{ timeout: 1000 }} />
    </div>

    <div class="demo-cta">
      <p>Want to explore it yourself?</p>
      <a class="btn btn-primary" href={PLAYGROUND_URL} target="_blank" rel="noopener noreferrer">
        Try the Playground
      </a>
    </div>
  </div>
</section>

<style>
  .demo-cta {
    margin-top: 32px;
    text-align: center;
  }

  .demo-cta p {
    margin-bottom: 14px;
    color: var(--muted);
  }
</style>
