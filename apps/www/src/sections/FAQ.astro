---
const FAQS = [
  {
    q: 'Does Maelstrom replace my application UI?',
    a: 'No — Maelstrom orchestrates the UI you already own. You describe your React components as Vessels, including their states, actions, and size needs; Maelstrom decides what to show and where based on user intent.',
  },
  {
    q: 'Can we start with existing React components?',
    a: 'Yes. Wrap your components with the React bindings, declare the variants and actions the AI may use, and keep your business logic in your code. Maelstrom handles orchestration, not component generation.',
  },
  {
    q: 'How does voice fit into the product?',
    a: 'Voice and text share the same intent flow: the user says or types what they want, then Maelstrom produces the same kind of action and layout plan. The open-source voice packages provide capture, playback, Voice Activity Detection (VAD), and React helpers. Today, the built-in voice providers are Deepgram and Google for speech-to-text (STT), plus Cartesia and Google for text-to-speech (TTS); Maelstrom Cloud adds managed voice with speech-to-text (STT), text-to-speech (TTS), and low-latency Voice Activity Detection (VAD).',
  },
  {
    q: 'Which models and providers can we use?',
    a: 'Maelstrom is provider-agnostic. The homepage stack targets Anthropic, OpenAI, Google, and OpenAI-compatible endpoints, and the engine adapter model lets you bring your own provider or connector when you need a different runtime.',
  },
  {
    q: 'What does Maelstrom control at runtime?',
    a: 'It chooses valid actions, component variants, and grid positions from the capabilities you declare. Your components still own rendering, data access, permissions, and side effects, so the AI operates inside boundaries you define.',
  },
  {
    q: 'What is open source, and what is Maelstrom Cloud?',
    a: 'The `@maelstrom-co/*` packages are MIT-licensed. Maelstrom Cloud is optional managed orchestration for teams that want hosted infrastructure, managed voice, multi-model routing, caching, edge deployment, and analytics without running those pieces themselves.',
  },
];
---
<section class="faq">
  <div class="container">
    <div class="how-head">
      <span class="eyebrow">Questions</span>
      <h2 class="section-h2">FAQ</h2>
    </div>
    <div class="faq-list">
      {FAQS.map((f, i) => (
        <div class={`faq-item ${i === 0 ? "open" : ""}`}>
          <h3 class="faq-q-h">
            <button
              type="button"
              class="faq-q"
              id={`faq-q-${i}`}
              aria-expanded={i === 0 ? "true" : "false"}
              aria-controls={`faq-a-${i}`}
            >
              <span class="faq-num mono">0{i + 1}</span>
              <span class="faq-q-text">{f.q}</span>
              <span class="faq-toggle" aria-hidden="true">{i === 0 ? "−" : "+"}</span>
            </button>
          </h3>
          <div class="faq-a-wrap" id={`faq-a-${i}`}>
            <p class="faq-a">{f.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>(".faq-item"));
  const buttons = items
    .map((it) => it.querySelector<HTMLButtonElement>(".faq-q"))
    .filter((b): b is HTMLButtonElement => b !== null);

  const setOpen = (item: HTMLElement, open: boolean) => {
    item.classList.toggle("open", open);
    const btn = item.querySelector<HTMLButtonElement>(".faq-q");
    const tog = item.querySelector(".faq-toggle");
    if (btn) btn.setAttribute("aria-expanded", String(open));
    if (tog) tog.textContent = open ? "−" : "+";
  };

  buttons.forEach((btn, idx) => {
    const item = items[idx];
    // A real <button> already fires click on Enter/Space, so we only handle the
    // accordion-pattern navigation keys here.
    btn.addEventListener("click", () => {
      const willOpen = !item.classList.contains("open");
      items.forEach((it) => setOpen(it, false));
      if (willOpen) setOpen(item, true);
    });
    btn.addEventListener("keydown", (e) => {
      switch (e.key) {
        case "ArrowDown":
          e.preventDefault();
          buttons[(idx + 1) % buttons.length].focus();
          break;
        case "ArrowUp":
          e.preventDefault();
          buttons[(idx - 1 + buttons.length) % buttons.length].focus();
          break;
        case "Home":
          e.preventDefault();
          buttons[0].focus();
          break;
        case "End":
          e.preventDefault();
          buttons[buttons.length - 1].focus();
          break;
        case "Escape":
          if (item.classList.contains("open")) setOpen(item, false);
          break;
      }
    });
  });
</script>
