---
const FAQS = [
  {
    q: 'Does Maelstrom replace my UI components?',
    a: 'You keep your components and application behavior. Maelstrom arranges the Vessels you define and invokes only their declared actions.',
  },
  {
    q: 'What do I need to get started?',
    a: 'The React starter needs Bun and runs locally without a provider key. It uses a deterministic planner to verify the integration. For a live model, configure a server-side planner and any credentials your provider requires.',
  },
  {
    q: 'Which frameworks can I use?',
    a: 'Maelstrom ships React bindings and a framework-independent TypeScript client. The starter uses React. Other renderers require their own integration with the client.',
  },
  {
    q: 'Do I need an account or a GitHub token?',
    a: 'Public npm installation needs no Maelstrom account or GitHub token. Provider accounts and usage charges depend on the model service you choose.',
  },
  {
    q: 'How stable is the API?',
    a: 'The first public release is 0.1.0. The API is still in the 0.x series and may change in later releases. Use the same version for all Maelstrom packages and read the release notes before upgrading.',
  },
  {
    q: 'What is the license?',
    a: 'Maelstrom is released under the MIT license. You can use it in commercial or personal projects under that license. The repository contains the full license text and contribution guide.',
  },
];
---
<section class="faq">
  <div class="container">
    <div class="how-head">
      <span class="eyebrow">Questions</span>
      <h2 class="section-h2">FAQ</h2>
    </div>
    <div class="faq-list">
      {FAQS.map((f, i) => (
        <div class={`faq-item ${i === 0 ? "open" : ""}`}>
          <h3 class="faq-q-h">
            <button
              type="button"
              class="faq-q"
              id={`faq-q-${i}`}
              aria-expanded={i === 0 ? "true" : "false"}
              aria-controls={`faq-a-${i}`}
            >
              <span class="faq-num mono">0{i + 1}</span>
              <span class="faq-q-text">{f.q}</span>
              <span class="faq-toggle" aria-hidden="true">{i === 0 ? "−" : "+"}</span>
            </button>
          </h3>
          <div class="faq-a-wrap" id={`faq-a-${i}`}>
            <p class="faq-a">{f.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>(".faq-item"));
  const buttons = items
    .map((it) => it.querySelector<HTMLButtonElement>(".faq-q"))
    .filter((b): b is HTMLButtonElement => b !== null);

  const setOpen = (item: HTMLElement, open: boolean) => {
    item.classList.toggle("open", open);
    const btn = item.querySelector<HTMLButtonElement>(".faq-q");
    const tog = item.querySelector(".faq-toggle");
    if (btn) btn.setAttribute("aria-expanded", String(open));
    if (tog) tog.textContent = open ? "−" : "+";
  };

  buttons.forEach((btn, idx) => {
    const item = items[idx];
    // A real <button> already fires click on Enter/Space, so we only handle the
    // accordion-pattern navigation keys here.
    btn.addEventListener("click", () => {
      const willOpen = !item.classList.contains("open");
      items.forEach((it) => setOpen(it, false));
      if (willOpen) setOpen(item, true);
    });
    btn.addEventListener("keydown", (e) => {
      switch (e.key) {
        case "ArrowDown":
          e.preventDefault();
          buttons[(idx + 1) % buttons.length].focus();
          break;
        case "ArrowUp":
          e.preventDefault();
          buttons[(idx - 1 + buttons.length) % buttons.length].focus();
          break;
        case "Home":
          e.preventDefault();
          buttons[0].focus();
          break;
        case "End":
          e.preventDefault();
          buttons[buttons.length - 1].focus();
          break;
        case "Escape":
          if (item.classList.contains("open")) setOpen(item, false);
          break;
      }
    });
  });
</script>
