---
const FAQS = [
  {
    q: 'Does Maelstrom replace my UI components?',
    a: 'No — it orchestrates them. You bring your existing React components (or a design system); Maelstrom decides which ones to show, in what variant, and where to place them based on user intent.',
  },
  {
    q: 'Which LLMs are supported?',
    a: 'Out of the box: Anthropic, OpenAI, Google, and any OpenAI-compatible endpoint. Bring-your-own provider via the `connector` interface.',
  },
  {
    q: 'Is the layout deterministic?',
    a: 'The Engine returns a typed `Plan` with explicit positions and variants. You can pin layouts, constrain ranges, or hand-author plans alongside AI-generated ones.',
  },
  {
    q: 'How do I handle streaming?',
    a: 'Plans stream token-by-token and apply incrementally. Vessels animate into position as the model is still thinking. The user feels response in <300ms.',
  },
  {
    q: 'What about offline / air-gapped?',
    a: "Run any local model via the `engine` adapter. We've validated against Llama 3, Qwen, and Mistral on consumer hardware.",
  },
  {
    q: 'Open source?',
    a: 'Yes — `@maelstrom-co/*` packages are MIT. Maelstrom Cloud is an optional managed runtime with paid tiers.',
  },
];
---
<section class="faq">
  <div class="container">
    <div class="how-head">
      <span class="eyebrow">Questions</span>
      <h2 class="section-h2">FAQ</h2>
    </div>
    <div class="faq-list">
      {FAQS.map((f, i) => (
        <div class={`faq-item ${i === 0 ? "open" : ""}`}>
          <h3 class="faq-q-h">
            <button
              type="button"
              class="faq-q"
              id={`faq-q-${i}`}
              aria-expanded={i === 0 ? "true" : "false"}
              aria-controls={`faq-a-${i}`}
            >
              <span class="faq-num mono">0{i + 1}</span>
              <span class="faq-q-text">{f.q}</span>
              <span class="faq-toggle" aria-hidden="true">{i === 0 ? "−" : "+"}</span>
            </button>
          </h3>
          <div class="faq-a-wrap" id={`faq-a-${i}`}>
            <p class="faq-a">{f.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>(".faq-item"));
  const buttons = items
    .map((it) => it.querySelector<HTMLButtonElement>(".faq-q"))
    .filter((b): b is HTMLButtonElement => b !== null);

  const setOpen = (item: HTMLElement, open: boolean) => {
    item.classList.toggle("open", open);
    const btn = item.querySelector<HTMLButtonElement>(".faq-q");
    const tog = item.querySelector(".faq-toggle");
    if (btn) btn.setAttribute("aria-expanded", String(open));
    if (tog) tog.textContent = open ? "−" : "+";
  };

  buttons.forEach((btn, idx) => {
    const item = items[idx];
    // A real <button> already fires click on Enter/Space, so we only handle the
    // accordion-pattern navigation keys here.
    btn.addEventListener("click", () => {
      const willOpen = !item.classList.contains("open");
      items.forEach((it) => setOpen(it, false));
      if (willOpen) setOpen(item, true);
    });
    btn.addEventListener("keydown", (e) => {
      switch (e.key) {
        case "ArrowDown":
          e.preventDefault();
          buttons[(idx + 1) % buttons.length].focus();
          break;
        case "ArrowUp":
          e.preventDefault();
          buttons[(idx - 1 + buttons.length) % buttons.length].focus();
          break;
        case "Home":
          e.preventDefault();
          buttons[0].focus();
          break;
        case "End":
          e.preventDefault();
          buttons[buttons.length - 1].focus();
          break;
        case "Escape":
          if (item.classList.contains("open")) setOpen(item, false);
          break;
      }
    });
  });
</script>
