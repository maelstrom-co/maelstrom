---
import { MAELSTROM_PACKAGE_VERSION } from '../data/package-version';

type FaqItem = {
  q: string;
  a: string;
  link?: {
    label: string;
    href: string;
  };
};

const FAQS: FaqItem[] = [
  {
    q: 'Does Maelstrom replace my UI components?',
    a: 'You keep your components and application behavior. Maelstrom arranges the Vessels you define and invokes only their declared actions.',
  },
  {
    q: 'Is this generative UI?',
    a: 'No. Maelstrom never generates components or markup. Whether a user asks through voice or text, the Engine chooses only among the Vessels, variants, and actions you ship.',
    link: {
      label: 'Read why Maelstrom takes this approach',
      href: 'https://docs.maelstrom-ai.co/understanding/why-maelstrom/',
    },
  },
  {
    q: 'What do I need to get started?',
    a: 'The React starter needs Bun and runs locally without a provider key. Its deterministic planner answers predefined requests with no model call, which verifies the local Engine and client integration. It does not test live model behavior. For a live model, configure a server-side planner and any credentials your provider requires.',
  },
  {
    q: 'Which frameworks can I use?',
    a: 'Maelstrom ships React bindings and a framework-independent TypeScript client. The starter uses React. Other renderers require their own integration with the client.',
  },
  {
    q: 'Where should I put provider credentials?',
    a: 'Keep provider credentials on your server. The React client sends intent to the Engine, which calls your configured planner. The local starter runs without provider credentials.',
  },
  {
    q: 'How stable is the API?',
    a: `Current packages: ${MAELSTROM_PACKAGE_VERSION}, still 0.x and subject to change. Use the same version for all Maelstrom packages and read the release notes before upgrading.`,
  },
  {
    q: 'What is the license?',
    a: 'Maelstrom is released under the MIT license. You can use it in commercial or personal projects under that license. The repository contains the full license text and contribution guide.',
  },
];
---

<section class="faq">
  <div class="container">
    <div class="how-head">
      <span class="eyebrow">Questions</span>
      <h2 class="section-h2">FAQ</h2>
    </div>
    <div class="faq-list">
      {FAQS.map((f, i) => (
        <details class="faq-item" name="maelstrom-faq" open={i === 0}>
          <summary class="faq-q" id={`faq-q-${i}`}>
            <h3 class="faq-q-h">
              <span class="faq-num mono">0{i + 1}</span>
              <span class="faq-q-text">{f.q}</span>
              <span class="faq-toggle" aria-hidden="true"></span>
            </h3>
          </summary>
          <div class="faq-a-wrap" id={`faq-a-${i}`}>
            <p class="faq-a">
              {f.a}
              {f.link && (
                <>
                  {' '}
                  <a href={f.link.href}>{f.link.label}</a>.
                </>
              )}
            </p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
<script>
  const questions = Array.from(
    document.querySelectorAll<HTMLElement>('.faq-q'),
  );
  questions.forEach((question, idx) => {
    question.addEventListener('keydown', (e) => {
      switch (e.key) {
        case 'ArrowDown':
          e.preventDefault();
          questions[(idx + 1) % questions.length].focus();
          break;
        case 'ArrowUp':
          e.preventDefault();
          questions[(idx - 1 + questions.length) % questions.length].focus();
          break;
        case 'Home':
          e.preventDefault();
          questions[0].focus();
          break;
        case 'End':
          e.preventDefault();
          questions[questions.length - 1].focus();
          break;
        case 'Escape': {
          const item = question.closest('details');
          if (item) item.open = false;
          break;
        }
      }
    });
  });
</script>
