---
import MaelstromLogo from '../components/MaelstromLogo.astro';
import { navLinks, socialLinks } from '../data/navigation';

const productLinks = [
  { label: 'How it works', href: '#how' },
  { label: 'Demo', href: '#demo' },
  { label: 'Private Beta', href: '#waitlist' },
];

const resourceLinks = navLinks.filter((link) => link.href.startsWith('http'));
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <MaelstromLogo height={30} color="white" style="margin-bottom: 20px;" />
      <p class="footer-tag">An open-source library for AI-orchestrated UI.</p>
    </div>
    <div class="footer-cols">
      <div>
        <div class="footer-col-h">Product</div>
        {productLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
      <div>
        <div class="footer-col-h">Resources</div>
        {resourceLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))}
      </div>
      <div>
        <div class="footer-col-h">Community</div>
        {socialLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} Maelstrom, Co. All rights reserved.</span>
    <span class="mono">{`{ orchestrating: true }`}</span>
  </div>
</footer>
