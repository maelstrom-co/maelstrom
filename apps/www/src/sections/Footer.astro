---
const navLinks = [
  { label: 'How It Works', href: '#how-it-works' },
  { label: 'Demo', href: '#demo' },
  { label: 'Docs', href: '#' },
];

const socialLinks = [
  {
    label: 'GitHub',
    href: 'https://github.com/maelstrom-co/maelstrom',
    icon: 'M12 2C6.477 2 2 6.477 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z',
  },
  {
    label: 'X',
    href: 'https://x.com/maelstrom_co',
    icon: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
  {
    label: 'Discord',
    href: '#',
    icon: 'M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z',
  },
];
---

<footer class="py-10 md:py-20 px-6 relative">
  <!-- Top border gradient -->
  <div class="absolute top-0 inset-x-0 h-px" style="background: linear-gradient(90deg, transparent, rgba(0, 240, 255, 0.08), transparent);"></div>

  <div class="max-w-4xl mx-auto">
    <!-- Top row: logo + nav + socials -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-8 mb-12">
      <!-- Logo -->
      <div class="flex items-center gap-2.5">
        <svg width="28" height="28" viewBox="0 0 48 48" class="footer-logo" aria-label="Maelstrom logo">
          <defs>
            <linearGradient id="footer-logo-grad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#00f0ff" />
              <stop offset="100%" stop-color="#0066ff" />
            </linearGradient>
          </defs>
          <path
            d="M24 24 C24 20, 28 18, 30 20 C32 22, 30 27, 26 28 C22 29, 17 26, 17 22 C17 17, 22 13, 27 13 C33 13, 37 18, 37 24 C37 31, 31 36, 24 36 C16 36, 11 30, 11 23 C11 15, 17 9, 25 9"
            fill="none"
            stroke="url(#footer-logo-grad)"
            stroke-width="1.5"
            stroke-linecap="round"
            opacity="0.6"
          />
          <circle cx="24" cy="24" r="1.5" fill="#00f0ff" opacity="0.7" />
        </svg>
        <span class="text-text/80 font-display font-semibold text-sm">Maelstrom</span>
      </div>

      <!-- Nav links -->
      <nav class="flex items-center gap-8" aria-label="Footer navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-text-muted/50 hover:text-text/80 transition-colors duration-300 text-sm"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Social icons -->
      <div class="flex items-center gap-4">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            class="text-text-muted/30 hover:text-cyan/70 transition-colors duration-300"
            aria-label={link.label}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="currentColor">
              <path d={link.icon} />
            </svg>
          </a>
        ))}
      </div>
    </div>

    <!-- Install snippet + star nudge -->
    <div class="flex flex-col items-center gap-4 pt-8 mb-8" style="border-top: 1px solid rgba(255, 255, 255, 0.04);">
      <code class="text-xs text-text-muted/50 font-mono px-4 py-2 rounded-md" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05);">
        npm install @maelstrom-co/react
      </code>
      <a
        href="https://github.com/maelstrom-co/maelstrom"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-xs text-text-muted/40 hover:text-cyan/70 transition-colors duration-300"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
        </svg>
        Star us on GitHub
      </a>
    </div>

    <!-- Copyright -->
    <div class="text-center">
      <p class="text-text-muted/20 text-xs">
        &copy; {new Date().getFullYear()} Maelstrom, Co. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-logo {
    filter: drop-shadow(0 0 6px rgba(0, 240, 255, 0.3));
  }
</style>
