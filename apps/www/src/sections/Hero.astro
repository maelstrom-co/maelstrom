---
import CopyButton from '../components/CopyButton.astro';
import { GITHUB_REPO_URL, INSTALL_COMMAND } from '../data/navigation';
import HeroDemo from '../islands/hero/HeroDemo';
import { getGitHubStarCount } from '../lib/github-stars';

const DOCS_URL = 'https://docs.maelstrom-ai.co';
const INSTALLATION_URL = `${DOCS_URL}/getting-started/installation/`;
const starCount = await getGitHubStarCount();
---
<section class="hero">
  <div class="container hero-inner">
    <div class="hero-left">
      <div class="hero-eyebrow">
        <a class="hero-pill" href={INSTALLATION_URL} target="_blank" rel="noopener noreferrer">
          <span class="hero-pill-dot"></span>
          Get started →
        </a>
      </div>
      <h1 class="hero-h1">
        <span class="line">Maelstrom</span>
        <span class="line accent">orchestrates</span>
        <span class="line">your UI.</span>
      </h1>
      <p class="hero-sub">
        An open-source library for AI-orchestrated UI. You author your components as
        vessels — their states, actions, and size hints — and a model arranges, resizes,
        and triggers them in real time, around the user's intent.
      </p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.5 2 2 6.6 2 12.3c0 4.5 2.9 8.4 6.8 9.8.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.4-3.4-1.4-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.7-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.3 9.3 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10.3 10.3 0 0 0 22 12.3C22 6.6 17.5 2 12 2z"/>
          </svg>
          Star on GitHub
          {starCount !== undefined && <span class="star-count">{starCount.toLocaleString("en-US")}</span>}
        </a>
        <a class="btn btn-ghost" href={DOCS_URL} target="_blank" rel="noopener noreferrer">
          Read the docs
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
      </div>
      <div class="hero-install">
        <div class="hero-install-bar">
          <div class="dot r"></div>
          <div class="dot y"></div>
          <div class="dot g"></div>
        </div>
        <div class="hero-install-row">
          <span class="prompt">$</span>
          <span class="cmd">
            <span style="color: #2BD46B;">npm</span> install <span style="color: #62C7FF;">@maelstrom-co/react@alpha</span>
          </span>
          <CopyButton text={INSTALL_COMMAND} />
        </div>
      </div>
    </div>
    <div class="hero-right">
      <HeroDemo client:idle={{ timeout: 1000 }} />
    </div>
  </div>
</section>
