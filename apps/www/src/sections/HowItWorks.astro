---
import dashboardSource from '../examples/how-it-works/Dashboard.tsx?raw';
import engineResponseSource from '../examples/how-it-works/engine-response.json?raw';
import maelstromSource from '../examples/how-it-works/maelstrom.ts?raw';
import ordersVesselSource from '../examples/how-it-works/orders.vessel.ts?raw';
import ordersVesselComponentSource from '../examples/how-it-works/OrdersVessel.tsx?raw';
import { highlightTypeScript } from '../lib/highlight-typescript';

type Step = {
  n: string;
  title: string;
  body: string;
  file: string;
  code: string;
};

const STEPS: Step[] = [
  {
    n: '01',
    title: 'Describe Your Components',
    body: "Each component gets a Vessel. It declares what the planner can use: the component's variants, the actions each variant offers, and its minimum size.",
    file: 'orders.vessel.ts',
    code: renderExample(ordersVesselSource),
  },
  {
    n: '02',
    title: 'Create Your Instance',
    body: 'Wire Vessels to components and create a typed Maelstrom instance. One factory call returns the Provider, the Chart, and fully typed hooks.',
    file: 'maelstrom.ts',
    code: renderExample(maelstromSource),
  },
  {
    n: '03',
    title: 'User Intent',
    body: 'Send a text intent with one call. With the optional voice integration, spoken intents take the same path. Your configured planner proposes a layout and declared actions for the goal.',
    file: 'Dashboard.tsx',
    code: renderExample(dashboardSource),
  },
  {
    n: '04',
    title: 'Engine Validates',
    body: 'The planner receives your declared Vessels, their variants and actions, the current layout, and the Chart dimensions. It proposes an Execution Plan and a layout. The Engine validates that proposal at runtime before your app receives it.',
    file: 'engine-response.json',
    code: renderExample(engineResponseSource),
  },
  {
    n: '05',
    title: 'UI Responds',
    body: 'The client applies the validated layout and runs your typed action handlers. TypeScript checks your Vessels and handlers at compile time. The Engine checks planner output at runtime.',
    file: 'OrdersVessel.tsx',
    code: renderExample(ordersVesselComponentSource),
  },
];

function renderExample(source: string): string {
  return highlightTypeScript(source.replace(/\n$/, ''));
}
---

<section class="how" id="how">
  <div class="container">
    <div class="how-head">
      <span class="eyebrow">The process</span>
      <h2 class="section-h2">How It Works</h2>
      <p class="section-sub">
        Describe the pieces. Maelstrom handles the orchestration.
      </p>
    </div>

    <div class="how-grid">
      <div class="how-steps-column">
        <div class="how-steps">
          {STEPS.map((s, i) => (
            <div data-idx={i} class={`how-step ${i === 0 ? 'active' : ''}`}>
              <div class="hs-num">{s.n}</div>
              <h3 class="hs-title">{s.title}</h3>
              <p class="hs-body">{s.body}</p>
              <div class="hs-progress" aria-hidden="true">
                <div class="hs-progress-bar"></div>
              </div>
              <div class="how-code-mobile win">
                <div class="win-bar">
                  <div class="dot r"></div>
                  <div class="dot y"></div>
                  <div class="dot g"></div>
                  <div class="title">{s.file}</div>
                </div>
                <pre class="code"><code set:html={s.code} /></pre>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="how-sticky">
        <div class="how-code-stack">
          {STEPS.map((s, i) => (
            <div
              class={`how-code-card win ${i === 0 ? 'active' : ''}`}
              data-card={i}
              data-example-file={s.file}
            >
              <div class="win-bar">
                <div class="dot r"></div>
                <div class="dot y"></div>
                <div class="dot g"></div>
                <div class="title">{s.file}</div>
              </div>
              <pre class="code"><code set:html={s.code} /></pre>
              <div class="how-code-step">
                {s.n} / 0{STEPS.length}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  /* The fixed-height desktop card fits the longest example, orders.vessel.ts, without scrolling. */
  .how-code-card pre.code {
    font-size: 12px;
    line-height: 1.4;
  }
</style>
<script>
  const steps = Array.from(
    document.querySelectorAll<HTMLElement>('.how-step[data-idx]'),
  );
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('.how-code-card[data-card]'),
  );
  const progressBars = steps.map((step) =>
    step.querySelector<HTMLElement>('.hs-progress-bar'),
  );
  if (steps.length) {
    let activeIndex = -1;
    let framePending = false;

    const updateSteps = () => {
      framePending = false;
      const bandTop = window.innerHeight * 0.3;
      const bandBottom = window.innerHeight * 0.45;
      const activationPoint = (bandTop + bandBottom) / 2;
      const bounds = steps.map((step) => step.getBoundingClientRect());
      let nearestIndex = 0;
      let nearestDistance = Infinity;

      // Nearest bounds keep gaps and jumps outside the activation band deterministic.
      bounds.forEach((stepBounds, index) => {
        const distance = Math.max(
          stepBounds.top - activationPoint,
          activationPoint - stepBounds.bottom,
          0,
        );
        if (distance < nearestDistance) {
          nearestDistance = distance;
          nearestIndex = index;
        }
      });

      const firstBounds = bounds[0];
      const lastBounds = bounds[bounds.length - 1];
      const progress = Math.min(
        1,
        Math.max(
          0,
          (bandBottom - firstBounds.top) /
            (lastBounds.bottom - firstBounds.top + bandBottom - bandTop),
        ),
      );
      progressBars.forEach((progressBar) => {
        if (progressBar) progressBar.style.width = `${progress * 100}%`;
      });

      if (nearestIndex === activeIndex) return;
      activeIndex = nearestIndex;
      steps.forEach((step, index) =>
        step.classList.toggle('active', index === activeIndex),
      );
      cards.forEach((card, index) =>
        card.classList.toggle('active', index === activeIndex),
      );
    };

    const scheduleUpdate = () => {
      if (framePending) return;
      framePending = true;
      requestAnimationFrame(updateSteps);
    };

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    updateSteps();
  }
</script>
