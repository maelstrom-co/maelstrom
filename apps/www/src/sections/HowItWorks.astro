---
type Step = {
  n: string;
  title: string;
  body: string;
  file: string;
  code: string;
};

const STEPS: Step[] = [
  {
    n: '01',
    title: 'Describe Your Components',
    body: 'Each component gets a Vessel — a declaration that tells the AI everything it needs to know: available states, actions it can trigger, and minimum size requirements.',
    file: 'orders.vessel.ts',
    code: [
      '<span class="tk-key">import</span> { defineVessel } <span class="tk-key">from</span> <span class="tk-str">"@maelstrom-co/protocol"</span>;',
      '',
      '<span class="tk-key">export const</span> <span class="tk-var">ordersVessel</span> = <span class="tk-fn">defineVessel</span>({',
      '  <span class="tk-att">id</span>: <span class="tk-str">"orders"</span>,',
      '  <span class="tk-att">name</span>: <span class="tk-str">"Orders Panel"</span>,',
      '  <span class="tk-att">description</span>: <span class="tk-str">"Displays a list of orders"</span>,',
      '  <span class="tk-att">defaultVariant</span>: <span class="tk-str">"list"</span>,',
      '  <span class="tk-att">variants</span>: {',
      '    <span class="tk-att">list</span>: {',
      '      <span class="tk-att">props</span>: {},',
      '      <span class="tk-att">minSize</span>: { <span class="tk-att">width</span>: <span class="tk-num">4</span>, <span class="tk-att">height</span>: <span class="tk-num">3</span> },',
      '      <span class="tk-att">actions</span>: [',
      '        { <span class="tk-att">name</span>: <span class="tk-str">"selectOrder"</span>, <span class="tk-att">transitionsTo</span>: <span class="tk-str">"details"</span> },',
      '      ],',
      '    },',
      '    <span class="tk-att">details</span>: {',
      '      <span class="tk-att">props</span>: {},',
      '      <span class="tk-att">minSize</span>: { <span class="tk-att">width</span>: <span class="tk-num">6</span>, <span class="tk-att">height</span>: <span class="tk-num">5</span> },',
      '    },',
      '  },',
      '});',
    ].join('\n'),
  },
  {
    n: '02',
    title: 'Create Your Instance',
    body: 'Wire vessels to components and create a typed Maelstrom instance. One factory call gives you everything — Provider, Chart, and fully typed hooks.',
    file: 'maelstrom.ts',
    code: [
      '<span class="tk-key">import</span> { createMaelstrom, vessel } <span class="tk-key">from</span> <span class="tk-str">"@maelstrom-co/react"</span>;',
      '<span class="tk-key">import</span> { ordersVessel } <span class="tk-key">from</span> <span class="tk-str">"./orders.vessel"</span>;',
      '<span class="tk-key">import</span> OrdersComponent <span class="tk-key">from</span> <span class="tk-str">"./OrdersComponent"</span>;',
      '',
      '<span class="tk-key">const</span> <span class="tk-var">ordersEntry</span> = <span class="tk-fn">vessel</span>(<span class="tk-var">ordersVessel</span>, <span class="tk-var">OrdersComponent</span>);',
      '',
      '<span class="tk-key">export const</span> <span class="tk-var">m</span> = <span class="tk-fn">createMaelstrom</span>({',
      '  <span class="tk-att">vessels</span>: [<span class="tk-var">ordersEntry</span>],',
      '});',
    ].join('\n'),
  },
  {
    n: '03',
    title: 'User Intent',
    body: 'Voice or text — same API. The user says what they want, and the AI figures out the rest.',
    file: 'Dashboard.tsx',
    code: [
      '<span class="tk-key">import</span> { m } <span class="tk-key">from</span> <span class="tk-str">"./maelstrom"</span>;',
      '',
      '<span class="tk-key">function</span> <span class="tk-fn">Dashboard</span>() {',
      '  <span class="tk-key">const</span> { <span class="tk-fn">processIntent</span> } = <span class="tk-var">m</span>.<span class="tk-fn">useMaelstrom</span>();',
      '',
      '  <span class="tk-com">// "Show me pending orders"</span>',
      '  <span class="tk-com">// "Open order 1847"</span>',
      '  <span class="tk-key">await</span> <span class="tk-fn">processIntent</span>(<span class="tk-var">userMessage</span>);',
      '}',
    ].join('\n'),
  },
  {
    n: '04',
    title: 'Engine Decides',
    body: 'The AI sees your entire UI — every vessel, every state, and all the space it has to work with. It returns a precise plan: which actions to fire and where to place each component.',
    file: 'MaelstromResponse',
    code: [
      '<span class="tk-com">// Engine returns actions + layout</span>',
      '{',
      '  <span class="tk-att">userMessage</span>: <span class="tk-str">"Opening order #1847"</span>,',
      '  <span class="tk-att">executionPlan</span>: [',
      '    { <span class="tk-att">instanceId</span>: <span class="tk-str">"orders-1"</span>, <span class="tk-att">action</span>: <span class="tk-str">"selectOrder"</span> }',
      '  ],',
      '  <span class="tk-att">layout</span>: {',
      '    <span class="tk-att">type</span>: <span class="tk-str">"tiling"</span>,',
      '    <span class="tk-att">tree</span>: [<span class="tk-str">"orders-1"</span>],',
      '    <span class="tk-att">instances</span>: [{ <span class="tk-att">variant</span>: <span class="tk-str">"details"</span> }],',
      '  },',
      '};',
    ].join('\n'),
  },
  {
    n: '05',
    title: 'UI Responds',
    body: 'Components transition, the layout shifts, everything updates — instantly and type-safe. Your code stays predictable while the AI orchestrates the experience.',
    file: 'App.tsx',
    code: [
      '<span class="tk-key">import</span> { ok } <span class="tk-key">from</span> <span class="tk-str">"@maelstrom-co/protocol"</span>;',
      '<span class="tk-key">import</span> { m } <span class="tk-key">from</span> <span class="tk-str">"./maelstrom"</span>;',
      '',
      '<span class="tk-key">function</span> <span class="tk-fn">OrdersVessel</span>({ <span class="tk-var">instanceId</span> }) {',
      '  <span class="tk-var">m</span>.<span class="tk-fn">useActions</span>(<span class="tk-str">"orders"</span>, <span class="tk-var">instanceId</span>, {',
      '    <span class="tk-fn">selectOrder</span>: <span class="tk-key">async</span> ({ <span class="tk-var">orderId</span> }) =&gt; {',
      '      <span class="tk-fn">loadOrder</span>(<span class="tk-var">orderId</span>);',
      '      <span class="tk-key">return</span> <span class="tk-fn">ok</span>(<span class="tk-var">undefined</span>);',
      '    },',
      '  });',
      '',
      '  <span class="tk-key">return</span> &lt;<span class="tk-ty">OrdersPanel</span> /&gt;;',
      '}',
    ].join('\n'),
  },
];
---
<section class="how" id="how">
  <div class="container">
    <div class="how-head">
      <span class="eyebrow">The process</span>
      <h2 class="section-h2">How It Works</h2>
      <p class="section-sub">Describe the pieces. Maelstrom handles the orchestration.</p>
    </div>

    <div class="how-grid">
      <div class="how-steps-column">
        <div class="how-steps">
          {STEPS.map((s, i) => (
            <div data-idx={i} class={`how-step ${i === 0 ? "active" : ""}`}>
              <div class="hs-num">{s.n}</div>
              <h3 class="hs-title">{s.title}</h3>
              <p class="hs-body">{s.body}</p>
              <div class="hs-progress" aria-hidden="true">
                <div class="hs-progress-bar"></div>
              </div>
              <div class="how-code-mobile win">
                <div class="win-bar">
                  <div class="dot r"></div>
                  <div class="dot y"></div>
                  <div class="dot g"></div>
                  <div class="title">{s.file}</div>
                </div>
                <pre class="code"><code set:html={s.code} /></pre>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="how-sticky">
        <div class="how-code-stack">
          {STEPS.map((s, i) => (
            <div class={`how-code-card win ${i === 0 ? "active" : ""}`} data-card={i}>
              <div class="win-bar">
                <div class="dot r"></div>
                <div class="dot y"></div>
                <div class="dot g"></div>
                <div class="title">{s.file}</div>
              </div>
              <pre class="code"><code set:html={s.code} /></pre>
              <div class="how-code-step">{s.n} / 0{STEPS.length}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  const steps = Array.from(document.querySelectorAll<HTMLElement>(".how-step[data-idx]"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".how-code-card[data-card]"));
  const progressBars = steps.map((step) => step.querySelector<HTMLElement>(".hs-progress-bar"));
  if (steps.length) {
    let activeIndex = -1;
    let framePending = false;

    const updateSteps = () => {
      framePending = false;
      const bandTop = window.innerHeight * 0.3;
      const bandBottom = window.innerHeight * 0.45;
      const activationPoint = (bandTop + bandBottom) / 2;
      const bounds = steps.map((step) => step.getBoundingClientRect());
      let nearestIndex = 0;
      let nearestDistance = Infinity;

      // Nearest bounds keep gaps and jumps outside the activation band deterministic.
      bounds.forEach((stepBounds, index) => {
        const distance = Math.max(stepBounds.top - activationPoint, activationPoint - stepBounds.bottom, 0);
        if (distance < nearestDistance) {
          nearestDistance = distance;
          nearestIndex = index;
        }
      });

      const firstBounds = bounds[0];
      const lastBounds = bounds[bounds.length - 1];
      const progress = Math.min(
        1,
        Math.max(
          0,
          (bandBottom - firstBounds.top) /
            (lastBounds.bottom - firstBounds.top + bandBottom - bandTop),
        ),
      );
      progressBars.forEach((progressBar) => {
        if (progressBar) progressBar.style.width = `${progress * 100}%`;
      });

      if (nearestIndex === activeIndex) return;
      activeIndex = nearestIndex;
      steps.forEach((step, index) => step.classList.toggle("active", index === activeIndex));
      cards.forEach((card, index) => card.classList.toggle("active", index === activeIndex));
    };

    const scheduleUpdate = () => {
      if (framePending) return;
      framePending = true;
      requestAnimationFrame(updateSteps);
    };

    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("resize", scheduleUpdate);
    updateSteps();
  }
</script>
