{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2022", "dom"],
    "allowJs": true,
    "outDir": "out-tsc/playwright",
    "sourceMap": false,
    "rootDir": "."
  },
  "include": [
    "e2e/**/*.ts",
    "e2e/**/*.js",
    "playwright.config.ts",
    "src/lib/blog-narration.ts",
    "src/lib/blog-narration-preview.ts",
    "tools/blog-narration-publication.ts",
    "tools/blog-narration-preview-publication.ts"
  ],
  "exclude": ["out-tsc", "test-output"]
}
