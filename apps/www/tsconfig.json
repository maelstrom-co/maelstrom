{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.astro",
    "astro.config.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": ["dist", "node_modules", "src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [
    {
      "path": "../../packages/react"
    },
    {
      "path": "../../packages/protocol"
    },
    {
      "path": "../../packages/client"
    }
  ]
}
