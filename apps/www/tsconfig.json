{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.astro",
    "astro.config.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": ["dist", "node_modules", "src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [
    // Explicit `tsconfig.json` file paths, not the bare directories tsc also
    // accepts. Playwright 1.62 resolves this file's `references` when it loads
    // anything in this folder and does not implement tsc's directory ->
    // tsconfig.json fallback, so bare directories abort the e2e run with
    // "Failed to resolve references path" before a single test executes.
    // `@nx/js:typescript-sync` treats these as up to date (verified with
    // `nx sync:check`); it is `tsconfig.lib.json` that it rejects, not this.
    {
      "path": "../../packages/react/tsconfig.json"
    },
    {
      "path": "../../packages/protocol/tsconfig.json"
    },
    {
      "path": "../../packages/client/tsconfig.json"
    },
    {
      "path": "./tsconfig.e2e.json"
    }
  ]
}
