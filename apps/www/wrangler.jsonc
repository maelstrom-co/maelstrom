{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "www",
  // Matches the newest date the pinned workerd supports (wrangler 4.115.0 ships
  // workerd 1.20260722.1); a later date would outrun the installed runtime.
  "compatibility_date": "2026-07-22",
  // Astro 7 bundles with Vite 8, whose Rolldown runtime chunk imports
  // `node:module`. workerd rejects that module outright without this flag, so
  // the build dies in the prerender pass before a single route is emitted.
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "maelstrom-ai.co", "custom_domain": true },
    { "pattern": "www.maelstrom-ai.co", "custom_domain": true }
  ],
  // Keep both deployment paths explicit: no stable workers.dev URL and no
  // version preview URLs in production (mirrors `workersDev: false`).
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "WAITLIST_DB",
      "database_name": "maelstrom-waitlist",
      "database_id": "936716c6-517e-449e-aee7-e1f17b87efdd",
      "migrations_dir": "../../infra/platform/migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["waitlist@notifications.maelstrom-ai.co"]
    }
  ],
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY"]
  },
  "env": {
    "preview": {
      "name": "maelstrom-www-preview",
      "workers_dev": true,
      "routes": []
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
