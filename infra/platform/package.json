{
  "name": "@maelstrom-co/platform-infra",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./waitlist-contract": "./src/WaitlistContract.ts",
    "./waitlist-schema": "./src/waitlist-schema.ts"
  },
  "scripts": {
    "test": "bun test test",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc -p tsconfig.infra.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "validate": "bun run typecheck && bun run test"
  },
  "nx": {
    "targets": {
      "validate": {
        "executor": "nx:run-commands",
        "cache": true,
        "options": {
          "cwd": "{projectRoot}",
          "command": "bun run validate"
        }
      }
    }
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "alchemy": "2.0.0-beta.77",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "*",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "jsonc-parser": "3.3.1",
    "typescript": "catalog:"
  }
}
