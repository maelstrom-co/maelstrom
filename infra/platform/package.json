{
  "name": "@maelstrom-co/platform-infra",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./waitlist-contract": "./src/WaitlistContract.ts",
    "./waitlist-schema": "./src/waitlist-schema.ts",
    "./community-contract": "./src/CommunityContract.ts"
  },
  "scripts": {
    "test": "bun test test operator-test",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc -p tsconfig.infra.json && tsc -p tsconfig.isolation.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "validate": "bun run typecheck && bun run test"
  },
  "nx": {
    "targets": {
      "validate": {
        "executor": "nx:run-commands",
        "cache": true,
        "options": {
          "cwd": "{projectRoot}",
          "command": "bun run validate"
        },
        "inputs": [
          "default",
          "^default",
          "toolchain",
          "externalValidationSources"
        ]
      },
      "test": {
        "inputs": [
          "default",
          "^default",
          "toolchain",
          "externalValidationSources"
        ]
      },
      "typecheck": {
        "inputs": [
          "default",
          "^default",
          "toolchain",
          "externalValidationSources"
        ]
      }
    },
    "namedInputs": {
      "externalValidationSources": [
        "{workspaceRoot}/scripts/**/*",
        "{workspaceRoot}/apps/*/alchemy*.run.ts",
        "{workspaceRoot}/apps/*/infra/**/*",
        "{workspaceRoot}/apps/*/migrations/**/*",
        "{workspaceRoot}/apps/*/project.json",
        "{workspaceRoot}/{apps,infra,packages,tools}/*/package.json",
        "{workspaceRoot}/.github/**/*",
        "{workspaceRoot}/apps/*/src/env.d.ts",
        "{workspaceRoot}/wrangler.{json,jsonc,toml}",
        "{workspaceRoot}/{apps,infra,packages,tools}/**/wrangler.{json,jsonc,toml}",
        "{workspaceRoot}/worker-configuration.d.ts",
        "{workspaceRoot}/{apps,infra,packages,tools}/**/worker-configuration.d.ts"
      ]
    }
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "alchemy": "2.0.0-beta.85",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "catalog:",
    "@alchemy.run/cloudflare": "2.0.0-beta.85"
  },
  "devDependencies": {
    "@distilled.cloud/aws": "1.0.0-rc.18",
    "@distilled.cloud/cloudflare": "1.0.0-rc.18",
    "@types/bun": "1.4.3",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "jsonc-parser": "3.3.1",
    "typescript": "catalog:",
    "@alchemy.run/aws": "2.0.0-beta.85"
  }
}
