{
  "name": "@maelstrom-co/platform-infra",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test test",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc -p tsconfig.infra.json",
    "validate": "bun run typecheck && bun run test"
  },
  "nx": {
    "targets": {
      "validate": {
        "executor": "nx:run-commands",
        "cache": true,
        "options": {
          "cwd": "{projectRoot}",
          "command": "bun run validate"
        }
      }
    }
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.111",
    "alchemy": "2.0.0-beta.73",
    "effect": "4.0.0-rc.111"
  },
  "devDependencies": {
    "@types/bun": "*",
    "jsonc-parser": "3.3.1",
    "typescript": "catalog:"
  }
}
