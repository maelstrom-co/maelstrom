{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/bunfig.toml",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/patches/**/*",
      "{workspaceRoot}/.gitignore"
    ],
    "toolchain": [
      {
        "runtime": "bun --version"
      },
      {
        "runtime": "node --version"
      },
      {
        "runtime": "node -p \"process.platform + '-' + process.arch\""
      }
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/vitest"
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "devTargetName": "dev",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static",
        "typecheckTargetName": "typecheck",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/oxlint",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "./tools/quality-plugin/src/index.ts"
    },
    {
      "plugin": "@maelstrom-co/astro-plugin",
      "options": {
        "buildTargetName": "build",
        "devTargetName": "dev",
        "previewTargetName": "preview",
        "typecheckTargetName": "typecheck"
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    }
  ],
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["build"],
      "cache": true,
      "inputs": ["default", "^default", "toolchain"]
    },
    "test": {
      "dependsOn": ["^build"],
      "options": {
        "passWithNoTests": true
      },
      "cache": true,
      "inputs": ["default", "^default", "toolchain"]
    },
    "dev": {
      "dependsOn": ["^build"]
    },
    "dev-livekit": {
      "dependsOn": ["^build"]
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/oxlint:lint": {
      "options": {
        "denyWarnings": true
      }
    }
  },
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true,
        "style": "tailwind",
        "linter": "none",
        "bundler": "vite"
      },
      "component": {
        "style": "tailwind"
      },
      "library": {
        "style": "tailwind",
        "linter": "none",
        "unitTestRunner": "none"
      }
    }
  },
  "release": {
    "projects": ["packages/*"],
    "projectsRelationship": "fixed",
    "version": {
      "specifierSource": "conventional-commits",
      "preVersionCommand": "bunx nx run-many -t build --projects='packages/*'",
      "currentVersionResolver": "git-tag",
      "versionActionsOptions": {
        "skipLockFileUpdate": true
      },
      "git": {
        "commitMessage": "chore(release): {version}"
      }
    },
    "releaseTag": {
      "pattern": "v{version}",
      "strictPreid": false
    },
    "changelog": {
      "projectChangelogs": false,
      "workspaceChangelog": {
        "file": false,
        "createRelease": "github",
        "renderer": "{workspaceRoot}/scripts/lib/release-changelog-renderer.ts"
      }
    }
  },
  "nxCloudId": "69b94146895823a3b98c76ba",
  "useDaemonProcess": false,
  "analytics": true,
  "migrate": {
    "agentic": true
  }
}
