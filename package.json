  "workspaces": [
    "apps/*",
    "infra/*",
    "packages/*",
    "tools/*"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "check": {
        "executor": "nx:run-commands",
        "options": {
          "command": "biome check . --error-on-warnings"
        },
        "cache": true,
        "inputs": [
          "{workspaceRoot}/**/*",
          {
            "externalDependencies": [
              "@biomejs/biome"
            ]
          }
        ]
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "parallel": false,
          "commands": [
            "tsc -p scripts/tsconfig.json",
            "tsc -p .github/actions/dco-check/tsconfig.json"
          ]
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "metadata": {
          "description": "Runs the root `scripts/` suite and the `.github/actions/` suites",
          "//": "The action suite is re-rooted with --cwd, not filtered: bun's test scanner skips dot-directories, so `bun test .github/actions` matches zero files and errors out (\"did not match any test files\", exit 1) instead of running the suite — even with --passWithNoTests=true."
        },
        "options": {
          "parallel": false,
          "commands": [
            "bun test scripts",
            "bun test --cwd .github/actions"
          ]
        }
      },
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  },
  "dependencies": {},
  "overrides": {
    "@effect/platform-node>undici": "8.12.2",
