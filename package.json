{
  "name": "@maelstrom-co/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "audit:public-api-docs": "bun tools/public-api-docs/audit.ts",
    "audit:strip-internal": "bun tools/public-api-docs/strip-internal-comparison.ts",
    "docs:lint": "bun scripts/lint-docs.ts",
    "format": "nx format:write --all",
    "format:check": "nx format:check --all",
    "check": "nx run-many -t lint && nx format:check --all"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "catalog": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "~14.4.0",
    "@astrojs/react": "^7.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@cloudflare/workers-types": "5.20260722.1",
    "@effect/sql-d1": "4.0.5",
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@langfuse/client": "5.13.1",
    "@opentelemetry/api": "1.9.1",
    "@pgrabovets/json-view": "^2.8.1",
    "@sinonjs/fake-timers": "^15.1.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/ai": "^1.0.0",
    "@tanstack/ai-gemini": "^1.0.0",
    "@tanstack/ai-openai": "^1.0.0",
    "@tanstack/react-router": "^1.167.4",
    "@tanstack/react-start": "^1.166.15",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/store": "^0.11.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@google-cloud/speech": "^7.3.0",
    "@google-cloud/text-to-speech": "^6.4.0",
    "astro": "^7.4.0",
    "effect": "4.0.5",
    "happy-dom": "21.0.4",
    "hono": "^4.13.16",
    "jsdom": "^27.3.0",
    "nanoid": "^5.1.11",
    "onnxruntime-web": "1.27.0",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@ricky0123/vad-web": "0.0.30",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "4.6.7",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.2",
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@microsoft/api-extractor": "^7.59.0",
    "@nx/devkit": "24.0.2",
    "@nx/js": "24.0.2",
    "@nx/oxlint": "24.0.2",
    "@nx/playwright": "24.0.2",
    "@nx/react": "24.0.2",
    "@nx/vite": "24.0.2",
    "@nx/vitest": "24.0.2",
    "@nx/web": "24.0.2",
    "@nx/workspace": "24.0.2",
    "@playwright/test": "^1.36.0",
    "@sinonjs/fake-timers": "15.1.1",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "0.7.10",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.23",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "1.4.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.0",
    "@types/sinonjs__fake-timers": "^15.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "ajv": "^8.0.0",
    "jiti": "2.4.2",
    "jsdom": "^27.3.0",
    "nx": "24.0.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "unplugin-dts": "^1.0.3",
    "verdaccio": "^6.0.5",
    "vite": "^8.3.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "5.0.5"
  },
  "workspaces": [
    "apps/*",
    "infra/*",
    "packages/*",
    "tools/*"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "parallel": false,
          "commands": [
            "tsc -p scripts/tsconfig.json",
            "tsc -p .github/actions/dco-check/tsconfig.json"
          ]
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "metadata": {
          "description": "Runs the root `scripts/` suite and the `.github/actions/` suites",
          "//": "The action suite is re-rooted with --cwd, not filtered: bun's test scanner skips dot-directories, so `bun test .github/actions` matches zero files and errors out (\"did not match any test files\", exit 1) instead of running the suite — even with --passWithNoTests=true."
        },
        "options": {
          "parallel": false,
          "commands": [
            "bun test scripts",
            "bun test --cwd .github/actions"
          ]
        },
        "inputs": [
          "{workspaceRoot}/**/*",
          "^default",
          "toolchain"
        ]
      },
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      },
      "sdk-validation": {
        "command": "bun --no-install scripts/assert-sdk-validation.ts",
        "cache": true,
        "dependsOn": [
          {
            "target": "build",
            "projects": [
              "@maelstrom-co/client",
              "@maelstrom-co/connectors",
              "@maelstrom-co/devtools",
              "@maelstrom-co/devtools-mcp-server",
              "@maelstrom-co/devtools-protocol",
              "@maelstrom-co/engine",
              "@maelstrom-co/planner-jev",
              "@maelstrom-co/planner-llm",
              "@maelstrom-co/protocol",
              "@maelstrom-co/react",
              "@maelstrom-co/react-devtools",
              "@maelstrom-co/realtime",
              "@maelstrom-co/realtime-livekit",
              "@maelstrom-co/realtime-livekit-agent",
              "@maelstrom-co/realtime-livekit-server",
              "@maelstrom-co/realtime-openai",
              "@maelstrom-co/realtime-openai-live",
              "@maelstrom-co/realtime-openai-live-server",
              "@maelstrom-co/realtime-openai-server",
              "@maelstrom-co/realtime-protocol",
              "@maelstrom-co/realtime-vad",
              "@maelstrom-co/react-realtime",
              "@maelstrom-co/telemetry"
            ]
          }
        ],
        "inputs": [
          "{workspaceRoot}/scripts/assert-sdk-validation.ts",
          "{workspaceRoot}/packages/client/package.json",
          "{workspaceRoot}/packages/connectors/package.json",
          "{workspaceRoot}/packages/devtools/package.json",
          "{workspaceRoot}/packages/devtools-mcp-server/package.json",
          "{workspaceRoot}/packages/devtools-protocol/package.json",
          "{workspaceRoot}/packages/engine/package.json",
          "{workspaceRoot}/packages/planner-jev/package.json",
          "{workspaceRoot}/packages/planner-llm/package.json",
          "{workspaceRoot}/packages/protocol/package.json",
          "{workspaceRoot}/packages/react/package.json",
          "{workspaceRoot}/packages/react-devtools/package.json",
          "{workspaceRoot}/packages/realtime/package.json",
          "{workspaceRoot}/packages/realtime-livekit/package.json",
          "{workspaceRoot}/packages/realtime-livekit-agent/package.json",
          "{workspaceRoot}/packages/realtime-livekit-server/package.json",
          "{workspaceRoot}/packages/realtime-openai/package.json",
          "{workspaceRoot}/packages/realtime-openai-live/package.json",
          "{workspaceRoot}/packages/realtime-openai-live-server/package.json",
          "{workspaceRoot}/packages/realtime-openai-server/package.json",
          "{workspaceRoot}/packages/realtime-protocol/package.json",
          "{workspaceRoot}/packages/realtime-vad/package.json",
          "{workspaceRoot}/packages/react-realtime/package.json",
          "{workspaceRoot}/packages/telemetry/package.json",
          {
            "dependentTasksOutputFiles": "**/*.js"
          },
          "toolchain",
          "{workspaceRoot}/scripts/lib/**/*.ts"
        ]
      },
      "lint": {
        "executor": "@nx/oxlint:lint",
        "cache": true,
        "options": {
          "lintFilePatterns": [
            "scripts",
            ".github",
            "tools",
            "vitest.config.ts"
          ],
          "nestedProjectRoots": [
            "tools/astro-plugin",
            "tools/evals-langfuse",
            "tools/evals-offline"
          ]
        },
        "inputs": [
          "{workspaceRoot}/scripts/**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,astro}",
          "{workspaceRoot}/.github/**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,astro}",
          "{workspaceRoot}/tools/**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,astro}",
          "!{workspaceRoot}/tools/astro-plugin/**/*",
          "!{workspaceRoot}/tools/evals-langfuse/**/*",
          "!{workspaceRoot}/tools/evals-offline/**/*",
          "{workspaceRoot}/vitest.config.ts",
          "{workspaceRoot}/.oxlintrc.json",
          "{workspaceRoot}/.gitignore",
          {
            "externalDependencies": [
              "oxlint"
            ]
          }
        ]
      }
    }
  },
  "dependencies": {},
  "overrides": {
    "@effect/platform-node>undici": "8.12.2",
    "@langfuse/core": "5.13.1",
    "@langfuse/tracing": "5.13.1",
    "@hono/node-server": "2.1.6",
    "compression": "1.8.2",
    "file-type": "21.3.4",
    "follow-redirects": "1.16.2",
    "glob": "14.0.3",
    "handlebars": "4.7.10",
    "hono": "4.13.16",
    "http-cache-semantics": "4.3.0",
    "@verdaccio/config>js-yaml": "5.5.0",
    "lodash": "4.18.1",
    "katex": "0.18.2",
    "miniflare>undici": "7.30.1",
    "nx>undici": "7.30.1",
    "minimatch": "11.0.3",
    "postcss-nested>postcss-selector-parser": "7.1.6",
    "qs": "6.16.1",
    "sharp": "0.35.5",
    "shell-quote": "1.11.0",
    "valibot": "1.4.2",
    "unifont>undici": "8.12.2"
  },
  "patchedDependencies": {
    "alchemy@2.0.0-beta.83": "patches/alchemy@2.0.0-beta.83.patch",
    "typedoc@0.28.20": "patches/typedoc@0.28.20.patch",
    "nx@24.0.2": "patches/nx@24.0.2.patch",
    "@verdaccio/core@8.2.1": "patches/@verdaccio%2Fcore@8.2.1.patch",
    "@verdaccio/utils@8.2.1": "patches/@verdaccio%2Futils@8.2.1.patch"
  }
}
