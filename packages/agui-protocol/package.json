{
  "name": "@maelstrom-co/agui-protocol",
  "version": "0.2.1",
  "description": "Experimental AG-UI workspace wire schemas and correlation evidence.",
  "keywords": [
    "maelstrom",
    "ag-ui",
    "protocol",
    "experimental"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/contract.js",
  "module": "./dist/contract.js",
  "types": "./dist/contract.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@maelstrom-co/source": "./src/contract.ts",
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "CONTRACT.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maelstrom-co/maelstrom.git",
    "directory": "packages/agui-protocol"
  },
  "homepage": "https://maelstrom-ai.co",
  "bugs": {
    "url": "https://github.com/maelstrom-co/maelstrom/issues"
  },
  "author": "Maelstrom (https://maelstrom-ai.co)",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.0",
    "@maelstrom-co/protocol": "workspace:*",
    "zod": "catalog:"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "command": "tsc -p tsconfig.lib.json --noEmit",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
