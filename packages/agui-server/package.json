{
  "name": "@maelstrom-co/agui-server",
  "version": "0.2.1",
  "description": "Experimental server AG-UI workspace admission and Engine dispatch.",
  "keywords": [
    "maelstrom",
    "ag-ui",
    "server",
    "experimental"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/server.js",
  "module": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@maelstrom-co/source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maelstrom-co/maelstrom.git",
    "directory": "packages/agui-server"
  },
  "homepage": "https://maelstrom-ai.co",
  "bugs": {
    "url": "https://github.com/maelstrom-co/maelstrom/issues"
  },
  "author": "Maelstrom (https://maelstrom-ai.co)",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@maelstrom-co/agui-protocol": "workspace:*",
    "@maelstrom-co/engine": "workspace:*"
  },
  "devDependencies": {
    "@maelstrom-co/protocol": "workspace:*"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "command": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "test": {
        "command": "bun --conditions=@maelstrom-co/source test",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
