{
  "name": "@maelstrom-co/agui",
  "version": "0.2.1",
  "description": "Experimental browser workspace AG-UI connector and application acknowledgment.",
  "keywords": [
    "maelstrom",
    "ag-ui",
    "generative-ui",
    "experimental"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/browser.js",
  "module": "./dist/browser.js",
  "types": "./dist/browser.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@maelstrom-co/source": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./browser": {
      "@maelstrom-co/source": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maelstrom-co/maelstrom.git",
    "directory": "packages/agui"
  },
  "homepage": "https://maelstrom-ai.co",
  "bugs": {
    "url": "https://github.com/maelstrom-co/maelstrom/issues"
  },
  "author": "Maelstrom (https://maelstrom-ai.co)",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.0",
    "@maelstrom-co/agui-protocol": "workspace:*",
    "@maelstrom-co/client": "workspace:*",
    "@maelstrom-co/protocol": "workspace:*"
  },
  "devDependencies": {
    "@maelstrom-co/agui-server": "workspace:*",
    "@maelstrom-co/engine": "workspace:*"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "command": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "test": {
        "command": "bun --conditions=@maelstrom-co/source test",
        "options": {
          "cwd": "{projectRoot}"
        },
        "inputs": [
          "default",
          "^default",
          "toolchain",
          "{workspaceRoot}/packages/agui-server/src/**/*",
          "{workspaceRoot}/packages/agui-protocol/src/**/*"
        ]
      }
    }
  }
}
