{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "lib": ["es2022", "dom"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"],
  "nx": {
    "sync": {
      "ignoredDependencies": [
        "@maelstrom-co/engine",
        "@maelstrom-co/agui-server"
      ]
    }
  },
  "references": [
    { "path": "../client/tsconfig.lib.json" },
    { "path": "../agui-protocol/tsconfig.lib.json" },
    { "path": "../protocol/tsconfig.lib.json" }
  ]
}
