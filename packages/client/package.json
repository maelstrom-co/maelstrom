{
  "name": "@maelstrom-co/client",
  "version": "0.0.0",
  "description": "Framework-agnostic Maelstrom client: chart manager, connection manager, command processor, vessel registry, and orchestrator, with a voice-session seam for realtime grounding.",
  "keywords": [
    "maelstrom",
    "ai",
    "llm",
    "dynamic-ui",
    "generative-ui",
    "orchestration",
    "state-machine",
    "framework-agnostic"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@maelstrom-co/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maelstrom-co/maelstrom.git",
    "directory": "packages/client"
  },
  "homepage": "https://maelstrom-ai.co",
  "bugs": {
    "url": "https://github.com/maelstrom-co/maelstrom/issues"
  },
  "author": "Maelstrom (https://maelstrom-ai.co)",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@maelstrom-co/protocol": "0.0.0",
    "@tanstack/store": "catalog:"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "catalog:"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "command": "tsc -p tsconfig.lib.json --noEmit",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "test": {
        "command": "bun test",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
