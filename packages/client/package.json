{
  "name": "@maelstrom-co/client",
  "version": "0.0.3-prealpha.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@maelstrom-co/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maelstrom-co/maelstrom.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "dependencies": {
    "@maelstrom-co/protocol-old": "workspace:*",
    "@tanstack/store": "catalog:"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "catalog:"
  },
  "nx": {
    "targets": {
      "test": {
        "command": "bun test",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
