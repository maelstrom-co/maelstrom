{
  "name": "@maelstrom-co/engine-old",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@maelstrom-co/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "dependencies": {
    "@tanstack/ai": "catalog:",
    "@tanstack/ai-gemini": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@maelstrom-co/protocol-old": "workspace:*"
  },
  "nx": {
    "name": "@maelstrom-co/engine-old",
    "targets": {
      "test": {
        "command": "bun test",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
