{
  "name": "@maelstrom-co/engine",
  "version": "0.1.0-alpha.7",
  "description": "Maelstrom orchestration engine: validates, heals and executes a planner's candidate into a layout and an execution plan for the current chart state.",
  "keywords": [
    "maelstrom",
    "ai",
    "dynamic-ui",
    "generative-ui",
    "orchestration",
    "layout"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@maelstrom-co/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./_testing": {
      "@maelstrom-co/source": "./src/_testing.ts",
      "types": "./dist/_testing.d.ts",
      "import": "./dist/_testing.js",
      "default": "./dist/_testing.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maelstrom-co/maelstrom.git",
    "directory": "packages/engine"
  },
  "homepage": "https://maelstrom-ai.co",
  "bugs": {
    "url": "https://github.com/maelstrom-co/maelstrom/issues"
  },
  "author": "Maelstrom (https://maelstrom-ai.co)",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@maelstrom-co/telemetry": "0.1.0-alpha.7",
    "@maelstrom-co/protocol": "0.1.0-alpha.7",
    "zod": "catalog:"
  },
  "nx": {
    "name": "@maelstrom-co/engine",
    "targets": {
      "typecheck": {
        "command": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "test": {
        "command": "bun test",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
