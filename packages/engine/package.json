{
  "name": "@maelstrom-co/engine",
  "version": "0.0.9-prealpha.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@maelstrom-co/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maelstrom-co/maelstrom.git",
    "directory": "packages/engine"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "dependencies": {
    "@maelstrom-co/protocol": "0.0.9-prealpha.0",
    "@tanstack/ai": "catalog:",
    "@tanstack/ai-gemini": "catalog:"
  },
  "nx": {
    "name": "@maelstrom-co/engine",
    "targets": {
      "test": {
        "command": "bun test",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
