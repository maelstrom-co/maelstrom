{
  "name": "@maelstrom-co/evals",
  "version": "0.1.0-alpha.6",
  "description": "Live evals for Maelstrom planners: whole-planner arm comparisons through the engine and single-stage evals on gold inputs. Workspace-internal, never published.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "dependencies": {
    "@maelstrom-co/engine": "0.1.0-alpha.6",
    "@maelstrom-co/planner-jev": "0.1.0-alpha.6",
    "@maelstrom-co/planner-llm": "0.1.0-alpha.6",
    "@maelstrom-co/protocol": "0.1.0-alpha.6",
    "@tanstack/ai": "catalog:",
    "@tanstack/ai-openai": "catalog:",
    "zod": "catalog:"
  },
  "nx": {
    "name": "@maelstrom-co/evals",
    "targets": {
      "eval": {
        "command": "bun --conditions=@maelstrom-co/source src/eval/cli.ts",
        "cache": false,
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "eval-stages": {
        "command": "bun --conditions=@maelstrom-co/source src/eval-stages/cli.ts",
        "cache": false,
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "typecheck": {
        "command": "tsc -p tsconfig.json --noEmit",
        "dependsOn": [
          "^build"
        ],
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "test": {
        "command": "bun test --conditions=@maelstrom-co/source",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
