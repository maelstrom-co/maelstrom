{
  "name": "@maelstrom-co/planner-jev",
  "version": "0.1.0",
  "description": "Experimental server-only Maelstrom planner that lets TypeSafe Jev decide selection, actions and tiling layout, with a small LLM call for the user message.",
  "keywords": [
    "maelstrom",
    "ai",
    "typesafe",
    "jev",
    "server",
    "planner"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@maelstrom-co/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./_internal": {
      "@maelstrom-co/source": "./src/_internal.ts",
      "types": "./dist/_internal.d.ts",
      "import": "./dist/_internal.js",
      "default": "./dist/_internal.js"
    },
    "./_testing": {
      "@maelstrom-co/source": "./src/_testing.ts",
      "types": "./dist/_testing.d.ts",
      "import": "./dist/_testing.js",
      "default": "./dist/_testing.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maelstrom-co/maelstrom.git",
    "directory": "packages/planner-jev"
  },
  "homepage": "https://maelstrom-ai.co",
  "bugs": {
    "url": "https://github.com/maelstrom-co/maelstrom/issues"
  },
  "author": "Maelstrom (https://maelstrom-ai.co)",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@maelstrom-co/engine": "0.1.0",
    "@maelstrom-co/protocol": "0.1.0",
    "@tanstack/ai": "catalog:",
    "zod": "catalog:"
  },
  "nx": {
    "name": "@maelstrom-co/planner-jev",
    "targets": {
      "typecheck": {
        "command": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "test": {
        "command": "bun test",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
