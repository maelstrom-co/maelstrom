{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "src/lib/__test-helpers__/layout-replay-fixtures/*.json"
  ],
  "references": [
    {
      "path": "../protocol/tsconfig.lib.json"
    },
    {
      "path": "../engine/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/lib/__test-helpers__/mock-chat.ts",
    "src/lib/__test-helpers__/poc-fixtures.ts"
  ]
}
