{
  "name": "@maelstrom-co/protocol",
  "version": "0.0.0",
  "description": "Shared types, Zod schemas, and message contract for Maelstrom — the transport-agnostic foundation for AI-orchestrated dynamic UI.",
  "keywords": [
    "maelstrom",
    "ai",
    "llm",
    "dynamic-ui",
    "generative-ui",
    "protocol",
    "schema",
    "zod",
    "vessel",
    "validation"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@maelstrom-co/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maelstrom-co/maelstrom.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://maelstrom-ai.co",
  "bugs": {
    "url": "https://github.com/maelstrom-co/maelstrom/issues"
  },
  "author": "Maelstrom (https://maelstrom-ai.co)",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "nanoid": "catalog:",
    "zod": "catalog:"
  },
  "nx": {
    "name": "@maelstrom-co/protocol",
    "targets": {
      "typecheck": {
        "command": "tsc -p tsconfig.lib.json --noEmit",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "test": {
        "command": "bun test",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
