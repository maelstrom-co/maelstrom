{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "rootDir": "src",
    "jsx": "react-jsx",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo"
  },
  "exclude": [
    "out-tsc",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.spec.tsx",
    "**/*.test.tsx",
    "**/*.test.isolated.tsx",
    "**/*.spec.js",
    "**/*.test.js",
    "**/*.spec.jsx",
    "**/*.test.jsx",
    "**/__tests__/*.ts",
    "**/__tests__/*.tsx",
    "**/__tests__/*.js",
    "**/__tests__/*.jsx"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../react/tsconfig.lib.json"
    },
    {
      "path": "../devtools/tsconfig.lib.json"
    },
    {
      "path": "../client/tsconfig.lib.json"
    },
    {
      "path": "../protocol/tsconfig.lib.json"
    }
  ]
}
