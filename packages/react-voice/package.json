{
  "name": "@maelstrom-co/react-voice",
  "version": "0.0.11-prealpha.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@maelstrom-co/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maelstrom-co/maelstrom.git",
    "directory": "packages/react-voice"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "peerDependencies": {
    "@maelstrom-co/react": "0.0.11-prealpha.0",
    "@maelstrom-co/voice": "0.0.11-prealpha.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@maelstrom-co/protocol": "0.0.11-prealpha.0"
  },
  "devDependencies": {
    "@maelstrom-co/client": "0.0.11-prealpha.0",
    "@maelstrom-co/react": "0.0.11-prealpha.0",
    "@maelstrom-co/voice": "0.0.11-prealpha.0",
    "@testing-library/react": "catalog:",
    "happy-dom": "catalog:"
  },
  "nx": {
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "parallel": false,
          "commands": [
            "bun test",
            "bun test ./src/lib/use-voice-import-failure.test.isolated.tsx",
            "bun test ./src/lib/use-voice-missing-export.test.isolated.tsx"
          ]
        }
      }
    }
  }
}
