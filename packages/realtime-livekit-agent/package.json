{
  "name": "@maelstrom-co/realtime-livekit-agent",
  "version": "0.0.0",
  "description": "Node LiveKit voice agent worker for Maelstrom: transcribes room audio via Deepgram STT and publishes the transcript back to the room; synthesizes engine responses via Cartesia TTS and publishes them into the room as an audio track.",
  "keywords": [
    "maelstrom",
    "ai",
    "llm",
    "dynamic-ui",
    "generative-ui",
    "realtime",
    "voice",
    "server",
    "node",
    "livekit",
    "deepgram",
    "cartesia"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@maelstrom-co/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maelstrom-co/maelstrom.git",
    "directory": "packages/realtime-livekit-agent"
  },
  "homepage": "https://maelstrom-ai.co",
  "bugs": {
    "url": "https://github.com/maelstrom-co/maelstrom/issues"
  },
  "author": "Maelstrom (https://maelstrom-ai.co)",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@livekit/agents": "^1.4.8",
    "@livekit/agents-plugin-cartesia": "^1.4.8",
    "@livekit/agents-plugin-deepgram": "^1.4.8",
    "@livekit/rtc-node": "^0.13.29",
    "@maelstrom-co/realtime-livekit": "0.0.0"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "command": "tsc -p tsconfig.lib.json --noEmit",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "test": {
        "command": "bun test --pass-with-no-tests",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
