{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["es2022"],
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "rewriteRelativeImportExtensions": true
  },
  "exclude": [
    "out-tsc",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/__tests__/*.ts"
  ],
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../realtime-livekit/tsconfig.lib.json"
    }
  ]
}
