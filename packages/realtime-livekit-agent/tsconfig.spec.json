{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "lib": ["es2022"],
    "types": ["bun"],
    "rootDir": ".",
    // The suite imports `./agent.ts` directly. Resolving it through the
    // project reference cannot work: the bundler emits declarations only for
    // the declared `index` entry, so `dist/agent.d.ts` never exists. This
    // config is only ever run with --noEmit, so importing source is safe.
    "allowImportingTsExtensions": true
  },
  // Sources are included alongside the suites because this project compiles
  // them directly rather than through a reference, and TypeScript requires
  // every file it pulls in to be listed.
  "include": ["src/**/*.ts"],
  // No reference to tsconfig.lib.json on purpose. A reference redirects
  // `./agent.ts` to that project's declaration output, which the bundler never
  // emits for a non-entry module, so the reference can only produce TS6305.
  // Compiling the sources directly is what type-checks the suite.
  "references": []
}
