{
  "name": "@maelstrom-co/realtime-livekit",
  "version": "0.0.0",
  "description": "LiveKit browser adapter for Maelstrom realtime voice: a RealtimeProviderAdapter backed by a cascaded STT/TTS pipeline.",
  "keywords": [
    "maelstrom",
    "ai",
    "llm",
    "dynamic-ui",
    "generative-ui",
    "realtime",
    "voice",
    "livekit",
    "webrtc",
    "token"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "maelstrom-livekit-assets": "./dist/bin/maelstrom-livekit-assets.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@maelstrom-co/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "@maelstrom-co/source": "./src/protocol.ts",
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./token": {
      "@maelstrom-co/source": "./src/livekit-token.ts",
      "types": "./dist/livekit-token.d.ts",
      "import": "./dist/livekit-token.js",
      "default": "./dist/livekit-token.js"
    },
    "./vad-assets": {
      "@maelstrom-co/source": "./src/vad-assets.ts",
      "types": "./dist/vad-assets.d.ts",
      "import": "./dist/vad-assets.js",
      "default": "./dist/vad-assets.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maelstrom-co/maelstrom.git",
    "directory": "packages/realtime-livekit"
  },
  "homepage": "https://maelstrom-ai.co",
  "bugs": {
    "url": "https://github.com/maelstrom-co/maelstrom/issues"
  },
  "author": "Maelstrom (https://maelstrom-ai.co)",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@maelstrom-co/client": "0.0.0",
    "@maelstrom-co/protocol": "0.0.0",
    "@maelstrom-co/realtime": "0.0.0",
    "@ricky0123/vad-web": "catalog:",
    "onnxruntime-web": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "livekit-client": ">=2.9.0"
  },
  "devDependencies": {
    "happy-dom": "catalog:",
    "livekit-client": "^2.13.1"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "command": "tsc -p tsconfig.lib.json --noEmit",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "test": {
        "command": "bun test --isolate",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
