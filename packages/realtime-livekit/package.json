{
  "name": "@maelstrom-co/realtime-livekit",
  "version": "0.1.0-alpha.7",
  "description": "LiveKit browser adapter for Maelstrom realtime voice: a RealtimeProviderAdapter backed by a cascaded STT/TTS pipeline.",
  "keywords": [
    "maelstrom",
    "ai",
    "llm",
    "dynamic-ui",
    "generative-ui",
    "realtime",
    "voice",
    "livekit",
    "webrtc",
    "token"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@maelstrom-co/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maelstrom-co/maelstrom.git",
    "directory": "packages/realtime-livekit"
  },
  "homepage": "https://maelstrom-ai.co",
  "bugs": {
    "url": "https://github.com/maelstrom-co/maelstrom/issues"
  },
  "author": "Maelstrom (https://maelstrom-ai.co)",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@maelstrom-co/client": "0.1.0-alpha.7",
    "@maelstrom-co/protocol": "0.1.0-alpha.7",
    "@maelstrom-co/realtime": "0.1.0-alpha.7",
    "@maelstrom-co/realtime-protocol": "0.1.0-alpha.7",
    "@maelstrom-co/realtime-vad": "0.1.0-alpha.7",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "livekit-client": ">=2.9.0"
  },
  "devDependencies": {
    "happy-dom": "catalog:",
    "livekit-client": "^2.13.1"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "command": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "test": {
        "command": "bun test --isolate",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
