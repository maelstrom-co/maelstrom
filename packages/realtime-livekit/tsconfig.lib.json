{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2022", "dom"],
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../protocol/tsconfig.lib.json"
    },
    {
      "path": "../client/tsconfig.lib.json"
    },
    {
      "path": "../realtime/tsconfig.lib.json"
    },
    {
      "path": "../realtime-protocol/tsconfig.lib.json"
    },
    {
      "path": "../realtime-vad/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/__tests__/*.ts"
  ]
}
