{
  "extends": ["../../.oxlintrc.json"],
  "rules": {
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@maelstrom-co/client",
            "message": "Browser imports violate packages/realtime-protocol/src/layer-boundary.test.ts."
          },
          {
            "name": "@maelstrom-co/react",
            "message": "Browser imports violate packages/realtime-protocol/src/layer-boundary.test.ts."
          },
          {
            "name": "@maelstrom-co/react-realtime",
            "message": "Browser imports violate packages/realtime-protocol/src/layer-boundary.test.ts."
          },
          {
            "name": "@maelstrom-co/realtime",
            "message": "Browser imports violate packages/realtime-protocol/src/layer-boundary.test.ts."
          },
          {
            "name": "@maelstrom-co/realtime-livekit",
            "message": "Browser imports violate packages/realtime-protocol/src/layer-boundary.test.ts."
          },
          {
            "name": "@maelstrom-co/realtime-openai",
            "message": "Browser imports violate packages/realtime-protocol/src/layer-boundary.test.ts."
          },
          {
            "name": "@maelstrom-co/realtime-openai-live",
            "message": "Browser imports violate packages/realtime-protocol/src/layer-boundary.test.ts."
          },
          {
            "name": "@maelstrom-co/realtime-vad",
            "message": "Browser imports violate packages/realtime-protocol/src/layer-boundary.test.ts."
          },
          {
            "name": "@maelstrom-co/devtools",
            "message": "Browser diagnostics are forbidden in server/worker packages. See packages/realtime-protocol/src/layer-boundary.test.ts."
          },
          {
            "name": "@maelstrom-co/react-devtools",
            "message": "Browser diagnostics are forbidden in server/worker packages. See packages/realtime-protocol/src/layer-boundary.test.ts."
          },
          {
            "name": "@tanstack/ai",
            "importNames": ["chat"],
            "message": "Import chat only in the agent run seam (packages/engine/src/lib/agent-session/agent-run-chat.ts, behind runAgent in agent-run.ts) or the two planner LLM call files. See packages/engine/src/lib/agent-session/chat-import-boundary.test.ts."
          }
        ],
        "patterns": [
          {
            "group": [
              "@maelstrom-co/client/**",
              "@maelstrom-co/react/**",
              "@maelstrom-co/react-realtime/**",
              "@maelstrom-co/realtime/**",
              "@maelstrom-co/realtime-livekit/**",
              "@maelstrom-co/realtime-openai/**",
              "@maelstrom-co/realtime-openai-live/**",
              "@maelstrom-co/realtime-vad/**",
              "@maelstrom-co/devtools/**",
              "@maelstrom-co/react-devtools/**"
            ],
            "message": "Server and worker packages cannot import browser packages. See packages/realtime-protocol/src/layer-boundary.test.ts."
          }
        ]
      }
    ]
  }
}
