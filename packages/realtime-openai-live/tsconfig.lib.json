{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "lib": ["es2022", "dom"],
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    {
      "path": "../realtime-protocol/tsconfig.lib.json"
    },
    {
      "path": "../realtime/tsconfig.lib.json"
    },
    {
      "path": "../protocol/tsconfig.lib.json"
    },
    {
      "path": "../client/tsconfig.lib.json"
    },
    {
      "path": "../engine/tsconfig.lib.json"
    }
  ]
}
