{
  "name": "@maelstrom-co/realtime-vad",
  "version": "0.1.1",
  "description": "Provider-neutral browser voice-activity detection for Maelstrom realtime voice: a MediaStream in, speech boundaries out.",
  "keywords": [
    "maelstrom",
    "ai",
    "llm",
    "dynamic-ui",
    "generative-ui",
    "realtime",
    "voice",
    "vad",
    "silero",
    "onnx",
    "turn-taking"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "maelstrom-vad-assets": "./dist/bin/maelstrom-vad-assets.js"
  },
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@maelstrom-co/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./assets": {
      "@maelstrom-co/source": "./src/vad-assets.ts",
      "types": "./dist/vad-assets.d.ts",
      "import": "./dist/vad-assets.js",
      "default": "./dist/vad-assets.js"
    },
    "./config": {
      "@maelstrom-co/source": "./src/browser-vad-config.ts",
      "types": "./dist/browser-vad-config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./asset-manifest": {
      "@maelstrom-co/source": "./src/vad-asset-manifest.ts",
      "types": "./dist/vad-asset-manifest.d.ts",
      "import": "./dist/asset-manifest.js",
      "default": "./dist/asset-manifest.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maelstrom-co/maelstrom.git",
    "directory": "packages/realtime-vad"
  },
  "homepage": "https://maelstrom-ai.co",
  "bugs": {
    "url": "https://github.com/maelstrom-co/maelstrom/issues"
  },
  "author": "Maelstrom (https://maelstrom-ai.co)",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@ricky0123/vad-web": "catalog:",
    "onnxruntime-web": "catalog:"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "command": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "test": {
        "command": "bun test --isolate",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
