+import * as Context from "effect/Context";
+import * as Data from "effect/Data";
+import * as Effect from "effect/Effect";
+import * as Option from "effect/Option";
+import * as Predicate from "effect/Predicate";
+import { stampedMode, type ProviderMode } from "./ProviderMode.ts";
+// Keep the provider's existing service key without importing an optional provider.
+class CloudflareEnvironment extends Context.Service<CloudflareEnvironment, Effect.Effect<{ readonly accountId: string }>>() ("Cloudflare::CloudflareEnvironment") {}
+
+/** An interrupted Worker cannot be recovered outside its original account. */
+export class WorkerAccountMismatch extends Data.TaggedError("WorkerAccountMismatch")<{
+  /** Account recorded before the original cloud mutation. */
+  expectedAccountId: string | undefined;
+  /** Account resolved for the current operation. */
+  actualAccountId: string | undefined;
+  /** Reason the operation requires account identity recovery. */
+  message: string;
+}> {}
+
+/** Account identity retained by a Worker generation or replacement ancestor. */
+export interface WorkerAccountState {
+  /** Resource provider owning this generation. */
+  resourceType?: string;
+  /** Mode in which the generation was created. */
+  providerMode?: ProviderMode;
+  /** Account persisted before a cloud mutation. */
+  workerAccountId?: string;
+  /** Recorded provider attributes, including the account for legacy rows. */
+  attr?: unknown;
+  /** Earlier generation whose cleanup still requires its original identity. */
+  old?: WorkerAccountState;
+}
+
+/** Resolve the account without performing a resource API request. */
+export const currentWorkerAccountId = Effect.gen(function* () {
+  const environment = yield* Effect.serviceOption(CloudflareEnvironment);
+  const accountId = Option.isSome(environment)
+    ? (yield* environment.value).accountId
+    : undefined;
+  if (typeof accountId !== "string" || !/^[a-f0-9]{32}$/i.test(accountId)) {
+    return yield* new WorkerAccountMismatch({
+      expectedAccountId: undefined,
+      actualAccountId: accountId,
+      message: "A live Worker requires a resolved Cloudflare account before planning or mutation.",
+    });
+  }
+  return accountId;
+});
+
+const attributeAccount = (state: WorkerAccountState): string | undefined =>
+  Predicate.hasProperty(state.attr, "accountId") && typeof state.attr.accountId === "string"
+    ? state.attr.accountId
+    : undefined;
+
+/** Read the account recorded in checkpoint metadata or trusted legacy attributes. */
+export const recordedWorkerAccountId = (state: WorkerAccountState): string | undefined =>
+  state.workerAccountId ?? attributeAccount(state);
+
+/** Whether a generation chain contains a live Worker requiring account validation. */
+export const hasLiveWorkerAccount = (state: WorkerAccountState): boolean =>
+  (state.resourceType === "Cloudflare.Worker" && stampedMode(state) !== "local") ||
+  (state.old !== undefined && hasLiveWorkerAccount(state.old));
+
+/** Refuse unknown or changed accounts before inspecting or mutating any generation. */
+export const assertWorkerAccount: (state: WorkerAccountState, accountId: string) => Effect.Effect<void, WorkerAccountMismatch> = Effect.fn(function* (
+  state: WorkerAccountState,
+  accountId: string,
+) {
+  if (state.resourceType === "Cloudflare.Worker" && stampedMode(state) !== "local") {
+    const expectedAccountId = recordedWorkerAccountId(state);
+    const attrsAccountId = attributeAccount(state);
+    if (expectedAccountId !== accountId || (attrsAccountId !== undefined && attrsAccountId !== accountId)) {
+      return yield* new WorkerAccountMismatch({
+        expectedAccountId,
+        actualAccountId: accountId,
+        message: expectedAccountId === undefined
+          ? "This Worker checkpoint has no recorded Cloudflare account; recover its identity manually."
+          : `Worker checkpoint account ${expectedAccountId} does not match current account ${accountId}.`,
+      });
+    }
+  }
+  if (state.old) yield* assertWorkerAccount(state.old, accountId);
+});
