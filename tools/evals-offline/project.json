{
  "name": "evals-offline",
  "projectType": "library",
  "implicitDependencies": ["@maelstrom-co/evals", "@maelstrom-co/client"],
  "targets": {
    "test": {
      "command": "bun test --conditions=@maelstrom-co/source tools/evals-offline",
      "cache": false
    },
    "typecheck": {
      "command": "tsc -p tools/evals-offline/tsconfig.json --noEmit",
      "dependsOn": ["^build"],
      "cache": false
    },
    "check": {
      "command": "biome check tools/evals-offline --error-on-warnings",
      "cache": false
    }
  }
}
